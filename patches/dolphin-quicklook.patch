+/*
+ * SPDX-FileCopyrightText: 2026 Mario STJr
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "quicklookpdfhandler.h"
+#include "quicklookconstants.h"
+
+#include <QTimer>
+#include <QtConcurrent>
+
+#ifdef HAVE_POPPLER
+#include <poppler-qt6.h>
+#endif
+
+namespace
+{
+using namespace QuickLookConstants;
+}
+
+QuickLookPdfHandler::QuickLookPdfHandler(QObject *parent)
+    : QObject(parent)
+{
+    m_hiResRenderTimer = new QTimer(this);
+    m_hiResRenderTimer->setSingleShot(true);
+    connect(m_hiResRenderTimer, &QTimer::timeout, this, &QuickLookPdfHandler::onHiResTimerTimeout);
+
+    connect(&m_hiResRenderWatcher, &QFutureWatcher<QImage>::finished, this, &QuickLookPdfHandler::onHiResRenderFinished);
+    connect(&m_pageRenderWatcher, &QFutureWatcher<QImage>::finished, this, &QuickLookPdfHandler::onPageRenderFinished);
+}
+
+QuickLookPdfHandler::~QuickLookPdfHandler()
+{
+    cancelPendingRenders();
+}
+
+QuickLookPdfHandler::LoadResult QuickLookPdfHandler::load(const QString &filePath)
+{
+#ifdef HAVE_POPPLER
+    m_document = Poppler::Document::load(filePath);
+    if (!m_document) {
+        return LoadResult::Failed;
+    }
+
+    if (m_document->isLocked()) {
+        m_filePath = filePath;
+        return LoadResult::PasswordRequired;
+    }
+
+    applyRenderHints(m_document.get());
+
+    m_bgDocument = Poppler::Document::load(filePath);
+    if (m_bgDocument) {
+        applyRenderHints(m_bgDocument.get());
+    }
+
+    m_totalPages = m_document->numPages();
+    m_currentPage = 0;
+    m_filePath = filePath;
+    m_pageCache.clear();
+    m_cacheLru.clear();
+
+    renderPage(0);
+
+    if (!m_currentImage.isNull()) {
+        m_hiResRenderTimer->start(PageRenderDelayMs);
+    }
+
+    return m_currentImage.isNull() ? LoadResult::Failed : LoadResult::Success;
+#else
+    Q_UNUSED(filePath)
+    return LoadResult::Failed;
+#endif
+}
+
+bool QuickLookPdfHandler::unlockWithPassword(const QString &password)
+{
+#ifdef HAVE_POPPLER
+    if (!m_document) {
+        return false;
+    }
+
+    const QByteArray passwordBytes = password.toUtf8();
+    m_document->unlock(passwordBytes, passwordBytes);
+
+    if (m_document->isLocked()) {
+        return false;
+    }
+
+    applyRenderHints(m_document.get());
+
+    m_bgDocument = Poppler::Document::load(m_filePath, passwordBytes, passwordBytes);
+    if (m_bgDocument) {
+        applyRenderHints(m_bgDocument.get());
+    }
+
+    m_totalPages = m_document->numPages();
+    m_currentPage = 0;
+    m_pageCache.clear();
+    m_cacheLru.clear();
+
+    renderPage(0);
+
+    if (!m_currentImage.isNull()) {
+        m_hiResRenderTimer->start(PageRenderDelayMs);
+    }
+
+    return !m_currentImage.isNull();
+#else
+    Q_UNUSED(password)
+    return false;
+#endif
+}
+
+void QuickLookPdfHandler::cleanup()
+{
+    cancelPendingRenders();
+
+#ifdef HAVE_POPPLER
+    m_page.reset();
+    m_document.reset();
+    m_bgDocument.reset();
+#endif
+
+    m_pageCache.clear();
+    m_cacheLru.clear();
+    m_currentImage = QImage();
+    m_currentPage = 0;
+    m_totalPages = 0;
+    m_renderedDpi = 0.0;
+    m_filePath.clear();
+}
+
+void QuickLookPdfHandler::cancelPendingRenders()
+{
+    m_hiResRenderWatcher.cancel();
+    m_hiResRenderWatcher.waitForFinished();
+    m_renderPending = false;
+
+    m_pageRenderWatcher.cancel();
+    m_pageRenderWatcher.waitForFinished();
+    m_pageRenderPending = false;
+
+    stopSpinner();
+    m_hiResRenderTimer->stop();
+}
+
+void QuickLookPdfHandler::setDisplayArea(int width, int height, qreal devicePixelRatio)
+{
+    m_areaWidth = width;
+    m_areaHeight = height;
+    m_devicePixelRatio = devicePixelRatio;
+}
+
+void QuickLookPdfHandler::scheduleHiResRerender(qreal zoomFactor)
+{
+#ifdef HAVE_POPPLER
+    m_lastZoomFactor = zoomFactor;
+
+    if (!m_page) {
+        return;
+    }
+    const qreal baseDpi = computeDisplayDpi(m_page->pageSizeF());
+    const qreal targetDpi = qBound(baseDpi, baseDpi * zoomFactor, MaxDpi);
+    const qreal ratio = targetDpi / m_renderedDpi;
+    if (ratio > 0.85 && ratio < 1.15) {
+        return;
+    }
+    m_hiResRenderTimer->start(RerenderDelayMs);
+#else
+    Q_UNUSED(zoomFactor)
+#endif
+}
+
+void QuickLookPdfHandler::navigatePage(int direction)
+{
+#ifdef HAVE_POPPLER
+    if (m_totalPages <= 1) {
+        return;
+    }
+
+    const int newPage = m_currentPage + direction;
+    if (newPage < 0 || newPage >= m_totalPages) {
+        return;
+    }
+
+    if (m_pageRenderPending || m_pageLoading) {
+        return;
+    }
+
+    m_hiResRenderTimer->stop();
+
+    m_currentPage = newPage;
+    m_page = m_document->page(newPage);
+    updateStatusText();
+
+    // Check cache
+    const QImage cached = cacheLookup(newPage);
+    if (!cached.isNull()) {
+        const QImage oldImage = m_currentImage;
+        m_currentImage = cached;
+        m_renderedDpi = BaseDpi;
+
+        Q_EMIT crossfadeReady(m_currentImage, oldImage);
+        m_hiResRenderTimer->start(PageRenderDelayMs);
+        prefetchAdjacentPages();
+        Q_EMIT requestUpdate();
+        return;
+    }
+
+    // Not cached — async render with spinner
+    m_pageLoading = true;
+    startSpinner();
+    Q_EMIT pageLoadingChanged(true);
+    renderPageAsync(newPage);
+    Q_EMIT requestUpdate();
+#else
+    Q_UNUSED(direction)
+#endif
+}
+
+int QuickLookPdfHandler::currentPage() const
+{
+    return m_currentPage;
+}
+
+int QuickLookPdfHandler::totalPages() const
+{
+    return m_totalPages;
+}
+
+bool QuickLookPdfHandler::isPageLoading() const
+{
+    return m_pageLoading;
+}
+
+qreal QuickLookPdfHandler::spinnerAngle() const
+{
+    return m_spinnerAngle;
+}
+
+QString QuickLookPdfHandler::statusText() const
+{
+    if (m_totalPages > 1) {
+        return QStringLiteral(" — Page %1 of %2").arg(m_currentPage + 1).arg(m_totalPages);
+    }
+    return QStringLiteral(" — 1 page");
+}
+
+void QuickLookPdfHandler::renderPage(int pageIndex)
+{
+#ifdef HAVE_POPPLER
+    if (!m_document || pageIndex < 0 || pageIndex >= m_totalPages) {
+        return;
+    }
+
+    m_currentPage = pageIndex;
+
+    const QImage cached = cacheLookup(pageIndex);
+    if (!cached.isNull()) {
+        m_currentImage = cached;
+        m_renderedDpi = BaseDpi;
+        updateStatusText();
+        Q_EMIT contentReady(m_currentImage);
+        return;
+    }
+
+    m_page = m_document->page(pageIndex);
+    if (!m_page) {
+        return;
+    }
+
+    const QSizeF pageSize = m_page->pageSizeF();
+    const qreal dpi = computeDisplayDpi(pageSize);
+    const QImage image = m_page->renderToImage(dpi, dpi);
+    if (image.isNull()) {
+        return;
+    }
+
+    m_currentImage = image;
+    m_renderedDpi = dpi;
+    updateStatusText();
+    Q_EMIT contentReady(m_currentImage);
+#else
+    Q_UNUSED(pageIndex)
+#endif
+}
+
+void QuickLookPdfHandler::renderPageAsync(int pageIndex)
+{
+#ifdef HAVE_POPPLER
+    if (m_pageRenderPending || m_renderPending || !m_bgDocument) {
+        return;
+    }
+
+    if (m_pageCache.contains(pageIndex)) {
+        return;
+    }
+
+    m_pageRenderPending = true;
+    m_pageRenderTargetPage = pageIndex;
+
+    std::shared_ptr<Poppler::Document> bgDoc = m_bgDocument;
+    const qreal dpi = computeDisplayDpi(m_page ? m_page->pageSizeF() : QSizeF(595, 842));
+    m_pageRenderWatcher.setFuture(QtConcurrent::run([bgDoc, pageIndex, dpi]() -> QImage {
+        auto pg = bgDoc->page(pageIndex);
+        if (!pg) {
+            return {};
+        }
+        return pg->renderToImage(dpi, dpi);
+    }));
+#else
+    Q_UNUSED(pageIndex)
+#endif
+}
+
+void QuickLookPdfHandler::onPageRenderFinished()
+{
+    m_pageRenderPending = false;
+
+    if (m_pageRenderWatcher.isCanceled()) {
+        return;
+    }
+
+    const QImage image = m_pageRenderWatcher.result();
+    if (image.isNull()) {
+        return;
+    }
+
+    const int targetPage = m_pageRenderTargetPage;
+    cacheInsert(targetPage, image);
+
+    if (targetPage == m_currentPage) {
+        if (m_pageLoading) {
+            stopSpinner();
+            Q_EMIT pageLoadingChanged(false);
+        }
+
+        const QImage oldImage = m_currentImage;
+        m_currentImage = image;
+        m_renderedDpi = BaseDpi;
+
+        Q_EMIT crossfadeReady(m_currentImage, oldImage);
+        m_hiResRenderTimer->start(PageRenderDelayMs);
+        Q_EMIT requestUpdate();
+    }
+
+    prefetchAdjacentPages();
+}
+
+void QuickLookPdfHandler::onHiResTimerTimeout()
+{
+    if (m_renderPending || m_pageRenderPending) {
+        m_hiResRenderTimer->start(RerenderDelayMs);
+        return;
+    }
+
+#ifdef HAVE_POPPLER
+    if (!m_page) {
+        return;
+    }
+
+    const qreal baseDpi = computeDisplayDpi(m_page->pageSizeF());
+
+    if (m_renderedDpi < baseDpi && qFuzzyCompare(m_lastZoomFactor, 1.0)) {
+        renderPageAsync(m_currentPage);
+        return;
+    }
+
+    const qreal targetDpi = qBound(baseDpi, baseDpi * m_lastZoomFactor, MaxDpi);
+    const qreal ratio = targetDpi / m_renderedDpi;
+    if (ratio > 0.85 && ratio < 1.15) {
+        return;
+    }
+
+    m_renderTargetDpi = targetDpi;
+    m_renderPending = true;
+    m_renderPageIndex = m_currentPage;
+
+    const qreal dpi = targetDpi;
+    const int pageIndex = m_currentPage;
+
+    if (m_bgDocument) {
+        std::shared_ptr<Poppler::Document> bgDoc = m_bgDocument;
+        m_hiResRenderWatcher.setFuture(QtConcurrent::run([bgDoc, dpi, pageIndex]() -> QImage {
+            auto pg = bgDoc->page(pageIndex);
+            if (!pg) {
+                return {};
+            }
+            return pg->renderToImage(dpi, dpi);
+        }));
+    } else {
+        const QString filePath = m_filePath;
+        m_hiResRenderWatcher.setFuture(QtConcurrent::run([filePath, dpi, pageIndex]() -> QImage {
+            auto doc = Poppler::Document::load(filePath);
+            if (!doc) {
+                return {};
+            }
+            doc->setRenderHint(Poppler::Document::Antialiasing);
+            doc->setRenderHint(Poppler::Document::TextAntialiasing);
+            doc->setRenderHint(Poppler::Document::ThinLineShape);
+            doc->setRenderHint(Poppler::Document::OverprintPreview);
+            auto pg = doc->page(pageIndex);
+            if (!pg) {
+                return {};
+            }
+            return pg->renderToImage(dpi, dpi);
+        }));
+    }
+#endif
+}
+
+void QuickLookPdfHandler::onHiResRenderFinished()
+{
+    m_renderPending = false;
+
+    if (m_hiResRenderWatcher.isCanceled()) {
+        return;
+    }
+
+    if (m_renderPageIndex != m_currentPage) {
+        return;
+    }
+
+    const QImage image = m_hiResRenderWatcher.result();
+    if (image.isNull()) {
+        return;
+    }
+
+    const QImage oldImage = m_currentImage;
+    m_currentImage = image;
+    m_renderedDpi = m_renderTargetDpi;
+
+    Q_EMIT crossfadeReady(m_currentImage, oldImage);
+    Q_EMIT requestUpdate();
+}
+
+void QuickLookPdfHandler::prefetchAdjacentPages()
+{
+#ifdef HAVE_POPPLER
+    if (m_pageRenderPending) {
+        return;
+    }
+
+    const int next = m_currentPage + 1;
+    const int prev = m_currentPage - 1;
+
+    if (next < m_totalPages && !m_pageCache.contains(next)) {
+        renderPageAsync(next);
+    } else if (prev >= 0 && !m_pageCache.contains(prev)) {
+        renderPageAsync(prev);
+    }
+#endif
+}
+
+void QuickLookPdfHandler::updateStatusText()
+{
+    Q_EMIT statusTextChanged(statusText());
+}
+
+void QuickLookPdfHandler::startSpinner()
+{
+    if (!m_spinnerTimer) {
+        m_spinnerTimer = new QTimer(this);
+        connect(m_spinnerTimer, &QTimer::timeout, this, [this]() {
+            m_spinnerAngle += 30.0;
+            if (m_spinnerAngle >= 360.0) {
+                m_spinnerAngle -= 360.0;
+            }
+            Q_EMIT requestUpdate();
+        });
+    }
+    m_spinnerAngle = 0.0;
+    m_spinnerTimer->start(50);
+}
+
+void QuickLookPdfHandler::stopSpinner()
+{
+    if (m_spinnerTimer) {
+        m_spinnerTimer->stop();
+    }
+    m_pageLoading = false;
+    m_spinnerAngle = 0.0;
+}
+
+#ifdef HAVE_POPPLER
+void QuickLookPdfHandler::applyRenderHints(Poppler::Document *doc)
+{
+    doc->setRenderHint(Poppler::Document::Antialiasing);
+    doc->setRenderHint(Poppler::Document::TextAntialiasing);
+    doc->setRenderHint(Poppler::Document::ThinLineShape);
+    doc->setRenderHint(Poppler::Document::OverprintPreview);
+}
+#endif
+
+qreal QuickLookPdfHandler::computeDisplayDpi(const QSizeF &pageSizePoints) const
+{
+    if (pageSizePoints.width() <= 0 || pageSizePoints.height() <= 0) {
+        return BaseDpi;
+    }
+
+    int areaW = m_areaWidth - 2 * ContentPadding;
+    int areaH = m_areaHeight - 2 * ContentPadding - BottomExtraSpace;
+
+    if (areaW <= 0 || areaH <= 0) {
+        return BaseDpi;
+    }
+
+    QSizeF displaySize(pageSizePoints);
+    displaySize.scale(areaW, areaH, Qt::KeepAspectRatio);
+
+    const qreal dpi = (displaySize.width() * m_devicePixelRatio) / (pageSizePoints.width() / 72.0);
+    return qBound(72.0, dpi, MaxDpi);
+}
+
+void QuickLookPdfHandler::cacheInsert(int pageIndex, const QImage &image)
+{
+    if (m_pageCache.contains(pageIndex)) {
+        m_cacheLru.removeOne(pageIndex);
+        m_cacheLru.prepend(pageIndex);
+        m_pageCache[pageIndex] = image;
+        return;
+    }
+
+    while (m_cacheLru.size() >= CacheMaxPages) {
+        const int evicted = m_cacheLru.takeLast();
+        m_pageCache.remove(evicted);
+    }
+
+    m_pageCache.insert(pageIndex, image);
+    m_cacheLru.prepend(pageIndex);
+}
+
+QImage QuickLookPdfHandler::cacheLookup(int pageIndex)
+{
+    if (!m_pageCache.contains(pageIndex)) {
+        return {};
+    }
+
+    m_cacheLru.removeOne(pageIndex);
+    m_cacheLru.prepend(pageIndex);
+
+    return m_pageCache.value(pageIndex);
+}
