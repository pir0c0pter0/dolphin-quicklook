+++ b/src/views/quicklook/quicklookpdfhandler.cpp
@@ -0,0 +1,496 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Mario STJr
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "quicklookpdfhandler.h"
+#include "quicklookconstants.h"
+
+#include <QFileInfo>
+#include <QRect>
+#include <QTimer>
+
+namespace
+{
+using namespace QuickLookConstants;
+} // namespace
+
+// ---------------------------------------------------------------------------
+// Constructor / Destructor
+// ---------------------------------------------------------------------------
+
+QuickLookPdfHandler::QuickLookPdfHandler(QObject *parent)
+    : QObject(parent)
+{
+    m_pdfDoc = new QPdfDocument(this);
+    m_pdfRenderer = new QPdfPageRenderer(this);
+    m_pdfRenderer->setDocument(m_pdfDoc);
+    m_pdfRenderer->setRenderMode(QPdfPageRenderer::RenderMode::MultiThreaded);
+
+    connect(m_pdfRenderer, &QPdfPageRenderer::pageRendered, this, &QuickLookPdfHandler::onPageRendered);
+
+    m_hiResRenderTimer = new QTimer(this);
+    m_hiResRenderTimer->setSingleShot(true);
+    connect(m_hiResRenderTimer, &QTimer::timeout, this, &QuickLookPdfHandler::onHiResTimerTimeout);
+}
+
+QuickLookPdfHandler::~QuickLookPdfHandler()
+{
+    cancelPendingRenders();
+}
+
+// ---------------------------------------------------------------------------
+// Public API
+// ---------------------------------------------------------------------------
+
+void QuickLookPdfHandler::loadAsync(const QString &filePath)
+{
+    // Bump the generation so any render still in flight from the previous
+    // document is discarded in onPageRendered.
+    ++m_generation;
+
+    m_pdfDoc->close();
+    m_filePath = filePath;
+    m_pageCache.clear();
+    m_cacheLru.clear();
+    m_currentPage = 0;
+    m_totalPages = 0;
+    m_currentImage = QImage();
+    m_previewRequestId = 0;
+    m_hiResRequestId = 0;
+    m_pageLoading = true;
+    startSpinner();
+    Q_EMIT pageLoadingChanged(true);
+
+    // Defend against decompression-bomb PDFs: QPdfDocument::load is synchronous
+    // for local files and will freeze the GUI on pathological input. A hard
+    // size cap is crude but effective; anything larger falls through to the
+    // default application.
+    const QFileInfo fileInfo(filePath);
+    if (fileInfo.exists() && fileInfo.size() > MaxPdfFileSizeBytes) {
+        stopSpinner();
+        m_pageLoading = false;
+        Q_EMIT pageLoadingChanged(false);
+        Q_EMIT asyncLoadReady(LoadResult::Failed);
+        return;
+    }
+
+    m_pdfDoc->load(filePath);
+
+    // QPdfDocument::load() is synchronous for local files — check status directly
+    const auto status = m_pdfDoc->status();
+    if (status == QPdfDocument::Status::Ready) {
+        m_totalPages = m_pdfDoc->pageCount();
+        requestPage(0, previewSize());
+    } else if (status == QPdfDocument::Status::Error) {
+        stopSpinner();
+        Q_EMIT pageLoadingChanged(false);
+        if (m_pdfDoc->error() == QPdfDocument::Error::IncorrectPassword) {
+            Q_EMIT asyncLoadReady(LoadResult::PasswordRequired);
+        } else {
+            Q_EMIT asyncLoadReady(LoadResult::Failed);
+        }
+    } else {
+        // Unexpected status (e.g. Loading for remote files)
+        stopSpinner();
+        Q_EMIT pageLoadingChanged(false);
+        Q_EMIT asyncLoadReady(LoadResult::Failed);
+    }
+}
+
+bool QuickLookPdfHandler::unlockWithPassword(const QString &password)
+{
+    // Close any residual state from the previous failed attempt so the new
+    // load starts from a clean slate (and not from cached error status).
+    m_pdfDoc->close();
+
+    m_pdfDoc->setPassword(password);
+    m_pdfDoc->load(m_filePath);
+
+    if (m_pdfDoc->status() != QPdfDocument::Status::Ready) {
+        // Drop the (incorrect) password so it does not linger in memory on
+        // the document object beyond the lifetime of this attempt.
+        m_pdfDoc->setPassword(QString());
+        return false;
+    }
+
+    // Password accepted — wipe it so it is not retained on the document for
+    // the rest of the preview session.
+    m_pdfDoc->setPassword(QString());
+
+    ++m_generation;
+    m_totalPages = m_pdfDoc->pageCount();
+    m_currentPage = 0;
+    m_pageCache.clear();
+    m_cacheLru.clear();
+    m_currentImage = QImage();
+    m_previewRequestId = 0;
+    m_hiResRequestId = 0;
+    m_pageLoading = true;
+    startSpinner();
+    Q_EMIT pageLoadingChanged(true);
+    requestPage(0, previewSize());
+    return true;
+}
+
+void QuickLookPdfHandler::cleanup()
+{
+    cancelPendingRenders();
+    m_pdfDoc->close();
+    m_pageCache.clear();
+    m_cacheLru.clear();
+    m_currentImage = QImage();
+    m_currentPage = 0;
+    m_totalPages = 0;
+    m_filePath.clear();
+    m_lastZoomFactor = 1.0;
+    m_previewRequestId = 0;
+    m_hiResRequestId = 0;
+    // Bump the generation one more time so any post-close renderer callback
+    // cannot write back into the now-empty cache.
+    ++m_generation;
+}
+
+void QuickLookPdfHandler::cancelPendingRenders()
+{
+    m_hiResRenderTimer->stop();
+    m_renderPending = false;
+    // QPdfPageRenderer has no cancel API — invalidate all outstanding
+    // requests by zeroing the IDs and bumping the generation. onPageRendered
+    // drops anything whose requestId or generation doesn't match.
+    m_previewRequestId = 0;
+    m_hiResRequestId = 0;
+    m_pendingRequests.clear();
+    ++m_generation;
+    stopSpinner();
+}
+
+void QuickLookPdfHandler::setDisplayArea(int width, int height, qreal devicePixelRatio)
+{
+    m_areaWidth = width;
+    m_areaHeight = height;
+    m_devicePixelRatio = devicePixelRatio;
+}
+
+void QuickLookPdfHandler::scheduleHiResRerender(qreal zoomFactor)
+{
+    m_lastZoomFactor = zoomFactor;
+    m_hiResRenderTimer->start(RerenderDelayMs);
+}
+
+void QuickLookPdfHandler::navigatePage(int direction)
+{
+    if (m_totalPages <= 1) {
+        return;
+    }
+
+    const int newPage = m_currentPage + direction;
+    if (newPage < 0 || newPage >= m_totalPages) {
+        return;
+    }
+
+    if (m_pageLoading) {
+        return;
+    }
+
+    m_hiResRenderTimer->stop();
+    m_currentPage = newPage;
+    updateStatusText();
+
+    const CachedPage cached = cacheLookup(newPage);
+    if (!cached.image.isNull()) {
+        const QImage oldImage = m_currentImage;
+        m_currentImage = cached.image;
+        Q_EMIT crossfadeReady(m_currentImage, oldImage);
+        m_hiResRenderTimer->start(PageRenderDelayMs);
+        Q_EMIT requestUpdate();
+        return;
+    }
+
+    // Not cached — request preview render with spinner
+    m_pageLoading = true;
+    startSpinner();
+    Q_EMIT pageLoadingChanged(true);
+    requestPage(newPage, previewSize());
+    Q_EMIT requestUpdate();
+}
+
+// ---------------------------------------------------------------------------
+// Getters
+// ---------------------------------------------------------------------------
+
+int QuickLookPdfHandler::currentPage() const
+{
+    return m_currentPage;
+}
+
+int QuickLookPdfHandler::totalPages() const
+{
+    return m_totalPages;
+}
+
+bool QuickLookPdfHandler::isPageLoading() const
+{
+    return m_pageLoading;
+}
+
+bool QuickLookPdfHandler::isHiResRendering() const
+{
+    return m_renderPending;
+}
+
+qreal QuickLookPdfHandler::spinnerAngle() const
+{
+    return m_spinnerAngle;
+}
+
+QString QuickLookPdfHandler::statusText() const
+{
+    if (m_totalPages > 1) {
+        return QStringLiteral(" — Page %1 of %2").arg(m_currentPage + 1).arg(m_totalPages);
+    }
+    return QStringLiteral(" — 1 page");
+}
+
+QSizeF QuickLookPdfHandler::pageLogicalSize() const
+{
+    if (m_pdfDoc && m_pdfDoc->status() == QPdfDocument::Status::Ready) {
+        return m_pdfDoc->pagePointSize(m_currentPage);
+    }
+    return {};
+}
+
+// ---------------------------------------------------------------------------
+// Private — render requests
+// ---------------------------------------------------------------------------
+
+void QuickLookPdfHandler::requestPage(int pageIndex, QSize size)
+{
+    QPdfDocumentRenderOptions opts;
+    m_previewRequestId = m_pdfRenderer->requestPage(pageIndex, size, opts);
+    m_pendingRequests.insert(m_previewRequestId, m_generation);
+}
+
+void QuickLookPdfHandler::requestHiRes(int pageIndex, QSize fullSize, QRect clipRect)
+{
+    QPdfDocumentRenderOptions opts;
+    if (!clipRect.isNull()) {
+        opts.setScaledSize(fullSize);
+        opts.setScaledClipRect(clipRect);
+    }
+    const QSize renderSize = clipRect.isNull() ? fullSize : clipRect.size();
+    m_hiResRequestId = m_pdfRenderer->requestPage(pageIndex, renderSize, opts);
+    m_pendingRequests.insert(m_hiResRequestId, m_generation);
+}
+
+// ---------------------------------------------------------------------------
+// Private — render callbacks
+// ---------------------------------------------------------------------------
+
+void QuickLookPdfHandler::onPageRendered(int page, QSize imageSize, const QImage &image, QPdfDocumentRenderOptions options, quint64 requestId)
+{
+    Q_UNUSED(imageSize)
+    Q_UNUSED(options)
+
+    // Drop any render whose tagged generation does not match the current one.
+    // This is the canonical stale-callback filter: covers preview, hi-res,
+    // and prefetch requests uniformly across document reload, password
+    // unlock, content-type switch, and cleanup.
+    const auto it = m_pendingRequests.constFind(requestId);
+    const bool generationMatches = (it != m_pendingRequests.constEnd() && it.value() == m_generation);
+    if (it != m_pendingRequests.constEnd()) {
+        m_pendingRequests.erase(it);
+    }
+    if (!generationMatches) {
+        return;
+    }
+
+    if (image.isNull()) {
+        return;
+    }
+
+    if (requestId == m_previewRequestId && page == m_currentPage) {
+        // Preview render complete
+        const bool isFirstLoad = m_currentImage.isNull();
+        const QImage oldImage = m_currentImage;
+        m_currentImage = image;
+
+        stopSpinner();
+        Q_EMIT pageLoadingChanged(false);
+
+        cacheInsert(page, image);
+
+        if (isFirstLoad) {
+            updateStatusText();
+            Q_EMIT contentReady(m_currentImage);
+            Q_EMIT asyncLoadReady(LoadResult::Success);
+        } else {
+            Q_EMIT crossfadeReady(m_currentImage, oldImage);
+        }
+
+        // Schedule hi-res upgrade
+        m_hiResRenderTimer->start(PageRenderDelayMs);
+        prefetchAdjacentPages();
+
+    } else if (requestId == m_hiResRequestId && page == m_currentPage) {
+        // Hi-res render complete
+        m_renderPending = false;
+        const QImage oldImage = m_currentImage;
+        m_currentImage = image;
+        Q_EMIT crossfadeReady(m_currentImage, oldImage);
+        Q_EMIT requestUpdate();
+
+    } else if (page != m_currentPage) {
+        // Prefetch render for an adjacent page — cache it silently
+        cacheInsert(page, image);
+    }
+}
+
+// ---------------------------------------------------------------------------
+// Private — hi-res timer
+// ---------------------------------------------------------------------------
+
+void QuickLookPdfHandler::onHiResTimerTimeout()
+{
+    if (m_renderPending || m_pageLoading) {
+        m_hiResRenderTimer->start(RerenderDelayMs);
+        return;
+    }
+
+    m_renderPending = true;
+    Q_EMIT hiResRenderStarted();
+
+    if (m_lastZoomFactor > 1.0) {
+        const QSize full = zoomSize(m_lastZoomFactor);
+        const QSize display = displaySize();
+        const int clipW = qMin(static_cast<int>(display.width() * 1.2), full.width());
+        const int clipH = qMin(static_cast<int>(display.height() * 1.2), full.height());
+        const int clipX = qMax(0, (full.width() - clipW) / 2);
+        const int clipY = qMax(0, (full.height() - clipH) / 2);
+        requestHiRes(m_currentPage, full, QRect(clipX, clipY, clipW, clipH));
+    } else {
+        requestHiRes(m_currentPage, displaySize());
+    }
+}
+
+// ---------------------------------------------------------------------------
+// Private — prefetch
+// ---------------------------------------------------------------------------
+
+void QuickLookPdfHandler::prefetchAdjacentPages()
+{
+    if (m_pageLoading || m_renderPending) {
+        return;
+    }
+
+    const int next = m_currentPage + 1;
+    const int prev = m_currentPage - 1;
+
+    if (next < m_totalPages && cacheLookup(next).image.isNull()) {
+        requestPage(next, previewSize());
+    } else if (prev >= 0 && cacheLookup(prev).image.isNull()) {
+        requestPage(prev, previewSize());
+    }
+}
+
+// ---------------------------------------------------------------------------
+// Private — size helpers
+// ---------------------------------------------------------------------------
+
+QSize QuickLookPdfHandler::previewSize() const
+{
+    const int availW = m_areaWidth - 2 * ContentPadding;
+    const int availH = m_areaHeight - 2 * ContentPadding - BottomExtraSpace;
+    if (availW <= 0 || availH <= 0) {
+        return QSize(800, 600);
+    }
+    // Half resolution for fast initial render
+    return QSize(availW / 2, availH / 2);
+}
+
+QSize QuickLookPdfHandler::displaySize() const
+{
+    const int availW = m_areaWidth - 2 * ContentPadding;
+    const int availH = m_areaHeight - 2 * ContentPadding - BottomExtraSpace;
+    if (availW <= 0 || availH <= 0) {
+        return QSize(800, 600);
+    }
+    return QSize(static_cast<int>(availW * m_devicePixelRatio), static_cast<int>(availH * m_devicePixelRatio));
+}
+
+QSize QuickLookPdfHandler::zoomSize(qreal zoomFactor) const
+{
+    const QSize base = displaySize();
+    return QSize(static_cast<int>(base.width() * zoomFactor), static_cast<int>(base.height() * zoomFactor));
+}
+
+// ---------------------------------------------------------------------------
+// Private — status text
+// ---------------------------------------------------------------------------
+
+void QuickLookPdfHandler::updateStatusText()
+{
+    Q_EMIT statusTextChanged(statusText());
+}
+
+// ---------------------------------------------------------------------------
+// Private — spinner
+// ---------------------------------------------------------------------------
+
+void QuickLookPdfHandler::startSpinner()
+{
+    if (!m_spinnerTimer) {
+        m_spinnerTimer = new QTimer(this);
+        connect(m_spinnerTimer, &QTimer::timeout, this, [this]() {
+            m_spinnerAngle += 30.0;
+            if (m_spinnerAngle >= 360.0) {
+                m_spinnerAngle -= 360.0;
+            }
+            Q_EMIT requestUpdate();
+        });
+    }
+    m_spinnerAngle = 0.0;
+    m_spinnerTimer->start(50);
+}
+
+void QuickLookPdfHandler::stopSpinner()
+{
+    if (m_spinnerTimer) {
+        m_spinnerTimer->stop();
+    }
+    m_pageLoading = false;
+    m_spinnerAngle = 0.0;
+}
+
+// ---------------------------------------------------------------------------
+// Private — LRU page cache
+// ---------------------------------------------------------------------------
+
+void QuickLookPdfHandler::cacheInsert(int pageIndex, const QImage &image)
+{
+    if (m_pageCache.contains(pageIndex)) {
+        m_cacheLru.removeOne(pageIndex);
+        m_cacheLru.prepend(pageIndex);
+        m_pageCache[pageIndex] = {image};
+        return;
+    }
+
+    while (m_cacheLru.size() >= CacheMaxPages) {
+        const int evicted = m_cacheLru.takeLast();
+        m_pageCache.remove(evicted);
+    }
+
+    m_pageCache.insert(pageIndex, {image});
+    m_cacheLru.prepend(pageIndex);
+}
+
+QuickLookPdfHandler::CachedPage QuickLookPdfHandler::cacheLookup(int pageIndex)
+{
+    if (!m_pageCache.contains(pageIndex)) {
+        return {};
+    }
+    m_cacheLru.removeOne(pageIndex);
+    m_cacheLru.prepend(pageIndex);
+    return m_pageCache.value(pageIndex);
+}
