+/*
+ * SPDX-FileCopyrightText: 2026 Pir0c0pter0
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef QUICKLOOKOVERLAY_H
+#define QUICKLOOKOVERLAY_H
+
+#include "dolphin_export.h"
+
+#include <QString>
+#include <QUrl>
+#include <QWidget>
+
+#include <memory>
+
+class QKeyEvent;
+class QMouseEvent;
+class QPaintEvent;
+class QResizeEvent;
+class QWheelEvent;
+
+/**
+ * Translucent full-pane overlay that hosts the inline preview. The widget
+ * is a thin façade: all state, private helpers, and QtPdf / QtMultimedia
+ * integration live in @ref QuickLookOverlay::Private defined in the
+ * implementation translation unit. Clients of this header do not transitively
+ * depend on the content-handler types, QtPdf, or QtMultimedia, which keeps
+ * the rebuild footprint of ifdef-guarded features small and matches
+ * Dolphin's existing `std::unique_ptr<QProxyStyle> m_proxyStyle` precedent
+ * in @ref DolphinView for owning private implementation state.
+ */
+class DOLPHIN_EXPORT QuickLookOverlay : public QWidget
+{
+    Q_OBJECT
+    Q_PROPERTY(qreal animationProgress READ animationProgress WRITE setAnimationProgress)
+
+public:
+    explicit QuickLookOverlay(QWidget *parent = nullptr);
+    ~QuickLookOverlay() override;
+
+    bool showPreview(const QUrl &fileUrl);
+    void hidePreview();
+    bool isPreviewActive() const;
+    static bool isSupportedMimeType(const QString &mimeType);
+
+    qreal animationProgress() const;
+    void setAnimationProgress(qreal progress);
+
+Q_SIGNALS:
+    void previewClosed();
+
+protected:
+    void paintEvent(QPaintEvent *event) override;
+    void mouseDoubleClickEvent(QMouseEvent *event) override;
+    void mousePressEvent(QMouseEvent *event) override;
+    void mouseMoveEvent(QMouseEvent *event) override;
+    void mouseReleaseEvent(QMouseEvent *event) override;
+    void wheelEvent(QWheelEvent *event) override;
+    void keyPressEvent(QKeyEvent *event) override;
+    void resizeEvent(QResizeEvent *event) override;
+
+private:
+    struct Private;
+    std::unique_ptr<Private> d;
+};
+
+#endif // QUICKLOOKOVERLAY_H
diff --git a/src/views/quicklook/quicklookpdfhandler.cpp b/src/views/quicklook/quicklookpdfhandler.cpp
new file mode 100644
index 0000000..ddd696b
--- /dev/null
+++ b/src/views/quicklook/quicklookpdfhandler.cpp
@@ -0,0 +1,653 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Pir0c0pter0
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "quicklookpdfhandler.h"
+#include "quicklookconstants.h"
+
+#include <QFileInfo>
+#include <QPainter>
+#include <QRect>
+#include <QTimer>
+
+#include <KLocalizedString>
+
+#include <algorithm>
+#include <cmath>
+
+namespace
+{
+using namespace QuickLookConstants;
+
+// QtPdf renders PDF pages with a transparent background. The overlay
+// composites the page over a dark dim layer, which turns white-paper PDFs
+// into illegible black-text-on-dark. Flatten any image with an alpha
+// channel onto an opaque white surface before it is shown or cached.
+QImage pdfPageOnWhite(const QImage &image)
+{
+    if (image.isNull() || !image.hasAlphaChannel()) {
+        return image;
+    }
+    QImage opaque(image.size(), QImage::Format_RGB32);
+    opaque.fill(Qt::white);
+    QPainter painter(&opaque);
+    painter.drawImage(0, 0, image);
+    painter.end();
+    return opaque;
+}
+} // namespace
+
+// ---------------------------------------------------------------------------
+// Constructor / Destructor
+// ---------------------------------------------------------------------------
+
+QuickLookPdfHandler::QuickLookPdfHandler(QObject *parent)
+    : QuickLookContentHandler(parent)
+{
+    m_pdfDoc = new QPdfDocument(this);
+
+    m_hiResRenderTimer = new QTimer(this);
+    m_hiResRenderTimer->setSingleShot(true);
+    connect(m_hiResRenderTimer, &QTimer::timeout, this, &QuickLookPdfHandler::onHiResTimerTimeout);
+}
+
+QuickLookPdfHandler::~QuickLookPdfHandler()
+{
+    cancelPendingRenders();
+    // MultiThreaded renders may still be queued. Sever the callback
+    // connection and tear the renderer down before the document so no
+    // pageRendered slot can fire into a half-destroyed handler.
+    if (m_pdfRenderer) {
+        disconnect(m_pdfRenderer, nullptr, this, nullptr);
+        delete m_pdfRenderer;
+        m_pdfRenderer = nullptr;
+    }
+}
+
+// ---------------------------------------------------------------------------
+// QuickLookContentHandler interface
+// ---------------------------------------------------------------------------
+
+QuickLookContentHandler::Kind QuickLookPdfHandler::kind() const
+{
+    return Kind::Pdf;
+}
+
+bool QuickLookPdfHandler::open(const QUrl &url)
+{
+    if (!isReadableLocalFile(url)) {
+        Q_EMIT loadFailed();
+        return false;
+    }
+    loadAsync(url.toLocalFile());
+    return true;
+}
+
+void QuickLookPdfHandler::close()
+{
+    cleanup();
+}
+
+bool QuickLookPdfHandler::isReady() const
+{
+    return !m_currentImage.isNull();
+}
+
+QSizeF QuickLookPdfHandler::logicalContentSize() const
+{
+    return pageLogicalSize();
+}
+
+// ---------------------------------------------------------------------------
+// Public API
+// ---------------------------------------------------------------------------
+
+void QuickLookPdfHandler::loadAsync(const QString &filePath)
+{
+    // Bump the generation so any render still in flight from the previous
+    // document is discarded in onPageRendered.
+    ++m_generation;
+    m_closed = false;
+    resetRenderer();
+
+    m_pdfDoc->close();
+    m_filePath = filePath;
+    m_pageCache.clear();
+    m_cacheLru.clear();
+    m_currentPage = 0;
+    m_totalPages = 0;
+    m_currentImage = QImage();
+    m_previewRequestId = 0;
+    m_hiResRequestId = 0;
+    m_pendingRequests.clear();
+    m_pageLoading = true;
+    startSpinner();
+    Q_EMIT pageLoadingChanged(true);
+
+    // Defend against decompression-bomb PDFs: QPdfDocument::load is synchronous
+    // for local files and will freeze the GUI on pathological input. A hard
+    // size cap is crude but effective; anything larger falls through to the
+    // default application.
+    const QUrl fileUrl = QUrl::fromLocalFile(filePath);
+    const QFileInfo fileInfo(filePath);
+    if (!isReadableLocalFile(fileUrl) || fileInfo.size() <= 0 || fileInfo.size() > MaxPdfFileSizeBytes) {
+        stopSpinner();
+        m_pageLoading = false;
+        Q_EMIT pageLoadingChanged(false);
+        Q_EMIT asyncLoadReady(LoadResult::Failed);
+        Q_EMIT loadFailed();
+        return;
+    }
+
+    m_pdfDoc->load(filePath);
+
+    // QPdfDocument::load() is synchronous for local files — check status directly
+    const auto status = m_pdfDoc->status();
+    if (status == QPdfDocument::Status::Ready) {
+        m_totalPages = m_pdfDoc->pageCount();
+        requestPage(0, previewSize());
+    } else if (status == QPdfDocument::Status::Error) {
+        stopSpinner();
+        Q_EMIT pageLoadingChanged(false);
+        if (m_pdfDoc->error() == QPdfDocument::Error::IncorrectPassword) {
+            Q_EMIT asyncLoadReady(LoadResult::PasswordRequired);
+        } else {
+            Q_EMIT asyncLoadReady(LoadResult::Failed);
+            Q_EMIT loadFailed();
+        }
+    } else {
+        // Unexpected status (e.g. Loading for remote files)
+        stopSpinner();
+        Q_EMIT pageLoadingChanged(false);
+        Q_EMIT asyncLoadReady(LoadResult::Failed);
+        Q_EMIT loadFailed();
+    }
+}
+
+bool QuickLookPdfHandler::unlockWithPassword(const QString &password)
+{
+    // Close any residual state from the previous failed attempt so the new
+    // load starts from a clean slate (and not from cached error status).
+    m_pdfDoc->close();
+
+    m_pdfDoc->setPassword(password);
+    m_pdfDoc->load(m_filePath);
+
+    if (m_pdfDoc->status() != QPdfDocument::Status::Ready) {
+        // Drop the (incorrect) password so it does not linger in memory on
+        // the document object beyond the lifetime of this attempt.
+        m_pdfDoc->setPassword(QString());
+        return false;
+    }
+
+    // Password accepted — wipe it so it is not retained on the document for
+    // the rest of the preview session.
+    m_pdfDoc->setPassword(QString());
+
+    ++m_generation;
+    resetRenderer();
+    m_totalPages = m_pdfDoc->pageCount();
+    m_currentPage = 0;
+    m_pageCache.clear();
+    m_cacheLru.clear();
+    m_currentImage = QImage();
+    m_previewRequestId = 0;
+    m_hiResRequestId = 0;
+    m_pendingRequests.clear();
+    m_pageLoading = true;
+    startSpinner();
+    Q_EMIT pageLoadingChanged(true);
+    requestPage(0, previewSize());
+    return true;
+}
+
+void QuickLookPdfHandler::cleanup()
+{
+    if (m_closed) {
+        return;
+    }
+    m_closed = true;
+    cancelPendingRenders();
+    m_pdfDoc->close();
+    m_pageCache.clear();
+    m_cacheLru.clear();
+    m_currentImage = QImage();
+    m_currentPage = 0;
+    m_totalPages = 0;
+    m_filePath.clear();
+    m_lastZoomFactor = 1.0;
+    m_previewRequestId = 0;
+    m_hiResRequestId = 0;
+    // Bump the generation one more time so any post-close renderer callback
+    // cannot write back into the now-empty cache.
+    ++m_generation;
+}
+
+void QuickLookPdfHandler::cancelPendingRenders()
+{
+    m_hiResRenderTimer->stop();
+    m_renderPending = false;
+    // QPdfPageRenderer has no cancel API — invalidate all outstanding
+    // requests by zeroing the IDs and bumping the generation. onPageRendered
+    // drops anything whose requestId or generation doesn't match.
+    m_previewRequestId = 0;
+    m_hiResRequestId = 0;
+    m_pendingRequests.clear();
+    ++m_generation;
+    stopSpinner();
+}
+
+void QuickLookPdfHandler::setDisplayArea(int width, int height, qreal devicePixelRatio)
+{
+    m_areaWidth = width;
+    m_areaHeight = height;
+    m_devicePixelRatio = devicePixelRatio;
+}
+
+void QuickLookPdfHandler::scheduleHiResRerender(qreal zoomFactor)
+{
+    m_lastZoomFactor = zoomFactor;
+    m_hiResRenderTimer->start(RerenderDelayMs);
+}
+
+void QuickLookPdfHandler::navigatePage(int direction)
+{
+    if (m_totalPages <= 1) {
+        return;
+    }
+
+    const int newPage = m_currentPage + direction;
+    if (newPage < 0 || newPage >= m_totalPages) {
+        return;
+    }
+
+    if (m_pageLoading) {
+        return;
+    }
+
+    m_hiResRenderTimer->stop();
+    m_currentPage = newPage;
+    updateStatusText();
+
+    const CachedPage cached = cacheLookup(newPage);
+    if (!cached.image.isNull()) {
+        const QImage oldImage = m_currentImage;
+        m_currentImage = cached.image;
+        Q_EMIT crossfadeReady(m_currentImage, oldImage);
+        m_hiResRenderTimer->start(PageRenderDelayMs);
+        Q_EMIT requestUpdate();
+        return;
+    }
+
+    // Not cached — request preview render with spinner
+    m_pageLoading = true;
+    startSpinner();
+    Q_EMIT pageLoadingChanged(true);
+    requestPage(newPage, previewSize());
+    Q_EMIT requestUpdate();
+}
+
+// ---------------------------------------------------------------------------
+// Getters
+// ---------------------------------------------------------------------------
+
+int QuickLookPdfHandler::currentPage() const
+{
+    return m_currentPage;
+}
+
+int QuickLookPdfHandler::totalPages() const
+{
+    return m_totalPages;
+}
+
+bool QuickLookPdfHandler::isPageLoading() const
+{
+    return m_pageLoading;
+}
+
+bool QuickLookPdfHandler::isHiResRendering() const
+{
+    return m_renderPending;
+}
+
+qreal QuickLookPdfHandler::spinnerAngle() const
+{
+    return m_spinnerAngle;
+}
+
+QString QuickLookPdfHandler::statusText() const
+{
+    if (m_totalPages > 1) {
+        return i18n("Page %1 of %2", m_currentPage + 1, m_totalPages);
+    }
+    return i18n("1 page");
+}
+
+QSizeF QuickLookPdfHandler::pageLogicalSize() const
+{
+    if (m_pdfDoc && m_pdfDoc->status() == QPdfDocument::Status::Ready) {
+        return m_pdfDoc->pagePointSize(m_currentPage);
+    }
+    return {};
+}
+
+// ---------------------------------------------------------------------------
+// Private — render requests
+// ---------------------------------------------------------------------------
+
+void QuickLookPdfHandler::requestPage(int pageIndex, QSize size)
+{
+    size = boundedRenderSize(size.width(), size.height());
+    if (size.isEmpty()) {
+        Q_EMIT loadFailed();
+        return;
+    }
+    QPdfDocumentRenderOptions opts;
+    m_previewRequestId = m_pdfRenderer->requestPage(pageIndex, size, opts);
+    m_pendingRequests.insert(m_previewRequestId, m_generation);
+}
+
+void QuickLookPdfHandler::requestHiRes(int pageIndex, QSize fullSize)
+{
+    // Always render the whole page. The overlay stretches the resulting
+    // pixmap to fill the full page draw-rect, so a partial (clipped)
+    // render would be distorted; the extra memory is the correct tradeoff.
+    fullSize = boundedRenderSize(fullSize.width(), fullSize.height());
+    if (fullSize.isEmpty()) {
+        m_renderPending = false;
+        return;
+    }
+    QPdfDocumentRenderOptions opts;
+    m_hiResRequestId = m_pdfRenderer->requestPage(pageIndex, fullSize, opts);
+    m_pendingRequests.insert(m_hiResRequestId, m_generation);
+}
+
+// ---------------------------------------------------------------------------
+// Private — render callbacks
+// ---------------------------------------------------------------------------
+
+void QuickLookPdfHandler::onPageRendered(int page,
+                                         QSize imageSize,
+                                         const QImage &image,
+                                         QPdfDocumentRenderOptions options,
+                                         quint64 requestId,
+                                         quint64 rendererGeneration)
+{
+    Q_UNUSED(imageSize)
+    Q_UNUSED(options)
+
+    // Drop any render whose tagged generation does not match the current one.
+    // This is the canonical stale-callback filter: covers preview, hi-res,
+    // and prefetch requests uniformly across document reload, password
+    // unlock, content-type switch, and cleanup.
+    if (rendererGeneration != m_generation || m_closed) {
+        return;
+    }
+
+    const auto it = m_pendingRequests.constFind(requestId);
+    const bool generationMatches = (it != m_pendingRequests.constEnd() && it.value() == m_generation);
+    if (it != m_pendingRequests.constEnd()) {
+        m_pendingRequests.erase(it);
+    }
+    if (!generationMatches) {
+        return;
+    }
+
+    // A hi-res response always clears the pending flag, even if the user
+    // has since navigated away — otherwise m_renderPending sticks forever.
+    const bool isHiResResponse = (requestId == m_hiResRequestId);
+    if (isHiResResponse) {
+        m_renderPending = false;
+    }
+
+    if (image.isNull()) {
+        // A null image still needs to release the UI state it was holding.
+        if (requestId == m_previewRequestId) {
+            stopSpinner();
+            Q_EMIT pageLoadingChanged(false);
+            Q_EMIT loadFailed();
+        } else if (isHiResResponse) {
+            Q_EMIT requestUpdate();
+        }
+        return;
+    }
+
+    // QtPdf pages have a transparent background; flatten onto white once so
+    // every consumer (display, cache, signals) sees an opaque image.
+    const QImage normalized = pdfPageOnWhite(image);
+
+    if (requestId == m_previewRequestId && page == m_currentPage) {
+        // Preview render complete
+        const bool isFirstLoad = m_currentImage.isNull();
+        const QImage oldImage = m_currentImage;
+        m_currentImage = normalized;
+
+        stopSpinner();
+        Q_EMIT pageLoadingChanged(false);
+
+        cacheInsert(page, normalized);
+
+        if (isFirstLoad) {
+            updateStatusText();
+            Q_EMIT contentReady(m_currentImage);
+            Q_EMIT asyncLoadReady(LoadResult::Success);
+        } else {
+            Q_EMIT crossfadeReady(m_currentImage, oldImage);
+        }
+
+        // Schedule hi-res upgrade
+        m_hiResRenderTimer->start(PageRenderDelayMs);
+        prefetchAdjacentPages();
+
+    } else if (isHiResResponse && page == m_currentPage) {
+        // Hi-res render complete. Hi-res images are intentionally NOT cached:
+        // the per-page cache holds preview-sized renders only.
+        const QImage oldImage = m_currentImage;
+        m_currentImage = normalized;
+        Q_EMIT crossfadeReady(m_currentImage, oldImage);
+        Q_EMIT requestUpdate();
+
+    } else if (!isHiResResponse && page != m_currentPage) {
+        // Prefetch render for an adjacent page — cache it silently.
+        // Guarded with !isHiResResponse so a stale hi-res render that
+        // arrives after navigation is never inserted at preview size.
+        cacheInsert(page, normalized);
+    }
+}
+
+// ---------------------------------------------------------------------------
+// Private — hi-res timer
+// ---------------------------------------------------------------------------
+
+void QuickLookPdfHandler::onHiResTimerTimeout()
+{
+    if (m_renderPending || m_pageLoading) {
+        m_hiResRenderTimer->start(RerenderDelayMs);
+        return;
+    }
+
+    m_renderPending = true;
+    Q_EMIT hiResRenderStarted();
+
+    // Render the whole page at the appropriate resolution. When zoomed we
+    // render the full zoomed page (no clip rect) so the image always maps
+    // 1:1 onto the overlay's full page draw-rect.
+    if (m_lastZoomFactor > 1.0) {
+        requestHiRes(m_currentPage, zoomSize(m_lastZoomFactor));
+    } else {
+        requestHiRes(m_currentPage, displaySize());
+    }
+}
+
+// ---------------------------------------------------------------------------
+// Private — prefetch
+// ---------------------------------------------------------------------------
+
+void QuickLookPdfHandler::prefetchAdjacentPages()
+{
+    if (m_pageLoading || m_renderPending) {
+        return;
+    }
+
+    const int next = m_currentPage + 1;
+    const int prev = m_currentPage - 1;
+
+    if (next < m_totalPages && cacheLookup(next).image.isNull()) {
+        requestPage(next, previewSize());
+    } else if (prev >= 0 && cacheLookup(prev).image.isNull()) {
+        requestPage(prev, previewSize());
+    }
+}
+
+// ---------------------------------------------------------------------------
+// Private — size helpers
+// ---------------------------------------------------------------------------
+
+QSize QuickLookPdfHandler::pageFitSize() const
+{
+    // QtPdf scales the page to fill the requested pixel rect exactly, so the
+    // render size must carry the PDF page's own aspect ratio. Fit the page's
+    // logical (point) size into the available viewport area with
+    // Qt::KeepAspectRatio; fall back to a sane default when either is invalid.
+    const int availW = m_areaWidth - 2 * ContentPadding;
+    const int availH = m_areaHeight - 2 * ContentPadding - BottomExtraSpace;
+    if (availW <= 0 || availH <= 0) {
+        return QSize(800, 600);
+    }
+    QSizeF pagePt;
+    if (m_pdfDoc && m_pdfDoc->status() == QPdfDocument::Status::Ready) {
+        pagePt = m_pdfDoc->pagePointSize(m_currentPage);
+    }
+    if (pagePt.width() <= 0.0 || pagePt.height() <= 0.0) {
+        return QSize(800, 600);
+    }
+    return pagePt.scaled(QSizeF(availW, availH), Qt::KeepAspectRatio).toSize();
+}
+
+QSize QuickLookPdfHandler::previewSize() const
+{
+    // Half resolution for a fast initial render.
+    const QSize fit = pageFitSize();
+    return boundedRenderSize(qMax(1, fit.width() / 2), qMax(1, fit.height() / 2));
+}
+
+QSize QuickLookPdfHandler::displaySize() const
+{
+    const QSize fit = pageFitSize();
+    return boundedRenderSize(fit.width() * m_devicePixelRatio, fit.height() * m_devicePixelRatio);
+}
+
+QSize QuickLookPdfHandler::zoomSize(qreal zoomFactor) const
+{
+    const QSize base = displaySize();
+    return boundedRenderSize(base.width() * zoomFactor, base.height() * zoomFactor);
+}
+
+QSize QuickLookPdfHandler::boundedRenderSize(qreal width, qreal height)
+{
+    if (!std::isfinite(width) || !std::isfinite(height) || width <= 0.0 || height <= 0.0) {
+        return {};
+    }
+
+    const qreal pixels = width * height;
+    const qreal scale = std::min({1.0,
+                                  static_cast<qreal>(MaxRenderDimension) / width,
+                                  static_cast<qreal>(MaxRenderDimension) / height,
+                                  std::sqrt(static_cast<qreal>(MaxRenderPixels) / pixels)});
+    return {qMax(1, qFloor(width * scale)), qMax(1, qFloor(height * scale))};
+}
+
+void QuickLookPdfHandler::resetRenderer()
+{
+    if (m_pdfRenderer) {
+        disconnect(m_pdfRenderer, nullptr, this, nullptr);
+        m_pdfRenderer->deleteLater();
+    }
+
+    m_pdfRenderer = new QPdfPageRenderer(this);
+    m_pdfRenderer->setDocument(m_pdfDoc);
+    m_pdfRenderer->setRenderMode(QPdfPageRenderer::RenderMode::MultiThreaded);
+    const quint64 rendererGeneration = m_generation;
+    connect(m_pdfRenderer,
+            &QPdfPageRenderer::pageRendered,
+            this,
+            [this, rendererGeneration](int page, QSize size, const QImage &image, QPdfDocumentRenderOptions options, quint64 requestId) {
+                onPageRendered(page, size, image, options, requestId, rendererGeneration);
+            });
+}
+
+// ---------------------------------------------------------------------------
+// Private — status text
+// ---------------------------------------------------------------------------
+
+void QuickLookPdfHandler::updateStatusText()
+{
+    Q_EMIT statusTextChanged(statusText());
+}
+
+// ---------------------------------------------------------------------------
+// Private — spinner
+// ---------------------------------------------------------------------------
+
+void QuickLookPdfHandler::startSpinner()
+{
+    m_spinnerAngle = 0.0;
+    if (!animationsEnabled()) {
+        return;
+    }
+    if (!m_spinnerTimer) {
+        m_spinnerTimer = new QTimer(this);
+        connect(m_spinnerTimer, &QTimer::timeout, this, [this]() {
+            m_spinnerAngle += 30.0;
+            if (m_spinnerAngle >= 360.0) {
+                m_spinnerAngle -= 360.0;
+            }
+            Q_EMIT requestUpdate();
+        });
+    }
+    m_spinnerTimer->start(50);
+}
+
+void QuickLookPdfHandler::stopSpinner()
+{
+    if (m_spinnerTimer) {
+        m_spinnerTimer->stop();
+    }
+    m_pageLoading = false;
+    m_spinnerAngle = 0.0;
+}
+
+// ---------------------------------------------------------------------------
+// Private — LRU page cache
+// ---------------------------------------------------------------------------
+
+void QuickLookPdfHandler::cacheInsert(int pageIndex, const QImage &image)
+{
+    if (m_pageCache.contains(pageIndex)) {
+        m_cacheLru.removeOne(pageIndex);
+        m_cacheLru.prepend(pageIndex);
+        m_pageCache[pageIndex] = {image};
+        return;
+    }
+
+    while (m_cacheLru.size() >= CacheMaxPages) {
+        const int evicted = m_cacheLru.takeLast();
+        m_pageCache.remove(evicted);
+    }
+
+    m_pageCache.insert(pageIndex, {image});
+    m_cacheLru.prepend(pageIndex);
+}
+
+QuickLookPdfHandler::CachedPage QuickLookPdfHandler::cacheLookup(int pageIndex)
+{
+    if (!m_pageCache.contains(pageIndex)) {
+        return {};
+    }
+    m_cacheLru.removeOne(pageIndex);
+    m_cacheLru.prepend(pageIndex);
+    return m_pageCache.value(pageIndex);
+}
