+
+void QuickLookMediaHandler::onVideoFrameChanged(const QVideoFrame &frame)
+{
+    QVideoFrame f = frame;
+    if (!f.isValid()) {
+        return;
+    }
+
+    // Don't waste CPU decoding frames that will never be shown.
+    if (m_phase == Phase::Closing) {
+        return;
+    }
+
+    // Throttle before the expensive GPU/CPU conversion. A consumed-frame flag
+    // alone is ineffective with direct signal delivery because painting clears
+    // it before the next queued frame arrives.
+    if (m_phase == Phase::Playing) {
+        if (m_videoFramePending || (m_lastVideoFrameTimer.isValid() && m_lastVideoFrameTimer.elapsed() < VideoFrameIntervalMs)) {
+            return;
+        }
+        m_lastVideoFrameTimer.restart();
+    }
+
+    QImage image = f.toImage();
+    if (image.isNull()) {
+        return;
+    }
+
+    // toImage() deliberately ignores presentation transforms.
+#if QT_VERSION >= QT_VERSION_CHECK(6, 7, 0)
+    const int rotation = static_cast<int>(f.rotation());
+    const bool mirrored = f.mirrored();
+#else
+    const int rotation = static_cast<int>(f.rotationAngle());
+    const bool mirrored = f.mirrored();
+#endif
+    if (rotation != 0) {
+        image = image.transformed(QTransform().rotate(rotation));
+    }
+    if (mirrored) {
+#if QT_VERSION >= QT_VERSION_CHECK(6, 9, 0)
+        image = image.flipped(Qt::Horizontal);
+#else
+        image = image.mirrored(true, false);
+#endif
+    }
+
+    // Downscale to display size — no point retaining 4K pixels we won't show.
+    const int maxW = m_videoDisplaySize.isValid() ? qBound(1, m_videoDisplaySize.width(), VideoMaxDisplayWidth) : VideoMaxDisplayWidth;
+    const int maxH = m_videoDisplaySize.isValid() ? qBound(1, m_videoDisplaySize.height(), VideoMaxDisplayHeight) : VideoMaxDisplayHeight;
+    if (image.width() > maxW || image.height() > maxH) {
+        image = image.scaled(maxW, maxH, Qt::KeepAspectRatio, Qt::FastTransformation);
+    }
+
+    if (m_phase == Phase::Loading) {
+        if (m_videoLoadTimer) {
+            m_videoLoadTimer->stop();
+            m_videoLoadTimer->deleteLater();
+            m_videoLoadTimer = nullptr;
+        }
+        m_phase = Phase::Animating;
+        m_mediaPlayer->pause();
+        emitReadyOnce(m_generation, image);
+        return;
+    }
+
+    if (m_phase == Phase::Playing) {
+        m_videoFramePending = true;
+        Q_EMIT contentReady(image);
+    }
+}
+
+void QuickLookMediaHandler::onPlaybackPositionChanged(qint64 position)
+{
+    if (m_contentType != ContentType::Audio) {
+        return;
+    }
+
+    const qint64 durSec = m_mediaPlayer->duration() / 1000;
+    const qint64 curSec = position / 1000;
+
+    auto formatTime = [](qint64 totalSec) -> QString {
+        const qint64 h = totalSec / 3600;
+        const qint64 m = (totalSec % 3600) / 60;
+        const qint64 s = totalSec % 60;
+        if (h > 0) {
+            return QStringLiteral("%1:%2:%3").arg(h).arg(m, 2, 10, QLatin1Char('0')).arg(s, 2, 10, QLatin1Char('0'));
+        }
+        return QStringLiteral("%1:%2").arg(m).arg(s, 2, 10, QLatin1Char('0'));
+    };
+
+    m_statusText = QStringLiteral("%1 / %2").arg(formatTime(curSec), formatTime(durSec));
+    Q_EMIT statusTextChanged(m_statusText);
+}
+
+void QuickLookMediaHandler::failOnce(quint64 generation)
+{
+    if (generation != m_generation || m_terminalDelivered || m_phase == Phase::Closing) {
+        return;
+    }
+    m_terminalDelivered = true;
+    Q_EMIT loadFailed();
+}
+
+void QuickLookMediaHandler::emitReadyOnce(quint64 generation, const QImage &image)
+{
+    if (generation != m_generation || m_readyDelivered || m_terminalDelivered || m_phase == Phase::Closing || image.isNull()) {
+        return;
+    }
+    m_readyDelivered = true;
+    m_terminalDelivered = true;
+    Q_EMIT readyToAnimate(image);
+}
