diff --git a/src/views/quicklook/quicklookcontenthandler.h b/src/views/quicklook/quicklookcontenthandler.h
new file mode 100644
index 0000000..ce311c4
--- /dev/null
+++ b/src/views/quicklook/quicklookcontenthandler.h
@@ -0,0 +1,124 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Pir0c0pter0
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef QUICKLOOKCONTENTHANDLER_H
+#define QUICKLOOKCONTENTHANDLER_H
+
+#include <QImage>
+#include <QObject>
+#include <QSize>
+#include <QSizeF>
+#include <QString>
+#include <QUrl>
+
+class QKeyEvent;
+class QMouseEvent;
+
+/**
+ * Abstract base for QuickLook content backends.
+ *
+ * Each concrete handler (image, PDF, video, audio) owns the data model and
+ * rendering pipeline for one kind of preview. QuickLookOverlay drives all
+ * handlers through this polymorphic surface; kind-specific entry points
+ * (page navigation, playback control, ...) remain on the derived class and
+ * are called after a static_cast when the overlay knows it is dealing with
+ * that kind.
+ *
+ * Ownership: handlers are created and destroyed by the overlay (QObject
+ * parent-child). Concrete handlers must release all external resources in
+ * close(); the destructor should then be a no-op beyond what parent-child
+ * teardown already provides.
+ */
+class QuickLookContentHandler : public QObject
+{
+    Q_OBJECT
+
+public:
+    enum class Kind {
+        Image,
+        Pdf,
+        Video,
+        Audio,
+    };
+
+    explicit QuickLookContentHandler(QObject *parent = nullptr);
+    ~QuickLookContentHandler() override;
+
+    /** True only for a local, regular file that can actually be opened for reading. */
+    static bool isReadableLocalFile(const QUrl &url);
+
+    /** The kind of content this handler is currently presenting. */
+    virtual Kind kind() const = 0;
+
+    /**
+     * Begin loading @p url. Returns false if the url is immediately
+     * rejected (missing, wrong mime, too large, ...). On true the handler
+     * will later emit contentReady()/loadFailed(). open() is always paired
+     * with a later close() when the overlay dismisses the preview.
+     */
+    virtual bool open(const QUrl &url) = 0;
+
+    /** Cancel any in-flight work and release resources. Safe to call
+     *  multiple times or before open(). */
+    virtual void close() = 0;
+
+    /** Has a first frame / rendered page been produced? */
+    virtual bool isReady() const = 0;
+
+    /** Short user-visible caption (page "n/m", time code, ...). */
+    virtual QString statusText() const = 0;
+
+    /**
+     * Natural content size in logical (device-independent) pixels. May
+     * return an invalid QSizeF before the first content is ready, in
+     * which case the overlay falls back to the delivered image size.
+     */
+    virtual QSizeF logicalContentSize() const = 0;
+
+    /** Notify the handler of the current viewport size so it can tune
+     *  render resolution. Default is a no-op. */
+    virtual void setViewportSize(const QSize &size);
+
+    /** Disable decorative timers when the active widget style reports that
+     *  animations are disabled. */
+    void setAnimationsEnabled(bool enabled);
+
+    /** Called once the show animation has settled. Used by the media
+     *  handler to start playback. Default is a no-op. */
+    virtual void onShowAnimationFinished();
+
+    /** Called as the overlay begins dismiss animation. Lets the handler
+     *  stop producing new frames without tearing down yet. Default no-op. */
+    virtual void setClosing();
+
+    /** Optional input hooks. Return true if consumed. Default no-op. */
+    virtual bool handleKey(QKeyEvent *event);
+    virtual bool handleMouse(QMouseEvent *event);
+
+protected:
+    bool animationsEnabled() const;
+
+Q_SIGNALS:
+    /** A new full-quality image is ready for display. */
+    void contentReady(const QImage &image);
+
+    /** A new high-resolution image is ready to crossfade over @p oldImage. */
+    void crossfadeReady(const QImage &newImage, const QImage &oldImage);
+
+    /** Status caption changed. */
+    void statusTextChanged(const QString &text);
+
+    /** Loading failed permanently; the overlay should dismiss. */
+    void loadFailed();
+
+    /** Request a repaint without a new image (animation tick etc.). */
+    void requestUpdate();
+
+private:
+    bool m_animationsEnabled = true;
+};
+
+#endif // QUICKLOOKCONTENTHANDLER_H
