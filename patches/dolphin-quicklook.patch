+void DolphinMainWindowTest::testQuickLookSpaceAndLifecycle()
+{
+    GeneralSettings::setQuickLookActivation(GeneralSettings::EnumQuickLookActivation::DoubleClick);
+    TestDir testDir;
+    const QUrl imageUrl = QUrl::fromLocalFile(testDir.filePath(QStringLiteral("preview.png")));
+    const QUrl textUrl = QUrl::fromLocalFile(testDir.filePath(QStringLiteral("plain.txt")));
+    QImage image(2, 2, QImage::Format_ARGB32);
+    QVERIFY(image.save(imageUrl.toLocalFile()));
+    testDir.createFile(textUrl.toLocalFile());
+
+    m_mainWindow->openDirectories({testDir.url()}, false);
+    m_mainWindow->show();
+    QVERIFY(QTest::qWaitForWindowExposed(m_mainWindow.data()));
+
+    DolphinTabPage *tabPage = m_mainWindow->m_tabWidget->currentTabPage();
+    DolphinView *view = tabPage->activeViewContainer()->view();
+    QTRY_COMPARE(view->itemsCount(), 2);
+    QuickLookOverlay *overlay = view->itemListContainer()->findChild<QuickLookOverlay *>(QString(), Qt::FindDirectChildrenOnly);
+    QVERIFY(overlay);
+
+    view->forceUrlsSelection(textUrl, {textUrl});
+    view->updateViewState();
+    QTest::keyClick(view->itemListContainer(), Qt::Key_Space);
+    QTRY_VERIFY(tabPage->activeViewContainer()->isSelectionModeEnabled()); // Unsupported files preserve Dolphin's native Space shortcut.
+    QTest::keyClick(view->itemListContainer(), Qt::Key_Space);
+    QTRY_VERIFY(!tabPage->activeViewContainer()->isSelectionModeEnabled());
+
+    view->forceUrlsSelection(imageUrl, {imageUrl});
+    view->updateViewState();
+    auto *controller = view->itemListContainer()->controller();
+    auto *graphicsView = qobject_cast<QGraphicsView *>(view->itemListContainer()->viewport());
+    const int imageIndex = static_cast<KFileItemModel *>(controller->model())->index(imageUrl);
+    QVERIFY(graphicsView);
+    QVERIFY(imageIndex >= 0);
+    QTest::mouseDClick(graphicsView->viewport(), Qt::LeftButton, Qt::NoModifier,
+                       graphicsView->mapFromScene(controller->view()->itemRect(imageIndex).center()));
+    QVERIFY(overlay->isPreviewActive());
+
+    auto *quickLookController = tabPage->findChild<QuickLookController *>();
+    QVERIFY(quickLookController);
+    quickLookController->closePreview();
+    QTRY_VERIFY(!overlay->isPreviewActive());
+
+    GeneralSettings::setQuickLookActivation(GeneralSettings::EnumQuickLookActivation::Space);
+    QTest::keyClick(view->itemListContainer(), Qt::Key_Space);
+    QVERIFY(overlay->isPreviewActive());
+
+    quickLookController->closePreview();
+    quickLookController->closePreview();
+    QTRY_VERIFY(!overlay->isPreviewActive());
+
+    QTest::keyClick(view->itemListContainer(), Qt::Key_Space);
+    QVERIFY(overlay->isPreviewActive());
+    tabPage->setActive(false);
+    QTRY_VERIFY(!overlay->isPreviewActive());
+}
+
 void DolphinMainWindowTest::cleanupTestCase()
 {
     m_mainWindow->showNormal();
