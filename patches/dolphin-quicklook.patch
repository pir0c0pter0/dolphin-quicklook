+/*
+ * SPDX-FileCopyrightText: 2026 Mario STJr
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef QUICKLOOKPDFHANDLER_H
+#define QUICKLOOKPDFHANDLER_H
+
+#include <QFutureWatcher>
+#include <QHash>
+#include <QImage>
+#include <QList>
+#include <QObject>
+#include <QSizeF>
+
+#include <memory>
+
+class QTimer;
+
+#ifdef HAVE_POPPLER
+namespace Poppler
+{
+class Document;
+class Page;
+}
+#endif
+
+class QuickLookPdfHandler : public QObject
+{
+    Q_OBJECT
+
+public:
+    enum class LoadResult {
+        Success,
+        Failed,
+        PasswordRequired
+    };
+
+    explicit QuickLookPdfHandler(QObject *parent = nullptr);
+    ~QuickLookPdfHandler() override;
+
+    LoadResult load(const QString &filePath);
+    bool unlockWithPassword(const QString &password);
+    void cleanup();
+    void cancelPendingRenders();
+
+    void navigatePage(int direction);
+    void setDisplayArea(int width, int height, qreal devicePixelRatio);
+    void scheduleHiResRerender(qreal zoomFactor);
+
+    int currentPage() const;
+    int totalPages() const;
+    bool isPageLoading() const;
+    qreal spinnerAngle() const;
+    QString statusText() const;
+
+Q_SIGNALS:
+    void contentReady(const QImage &image);
+    void crossfadeReady(const QImage &newImage, const QImage &oldImage);
+    void statusTextChanged(const QString &text);
+    void pageLoadingChanged(bool loading);
+    void requestUpdate();
+
+private:
+    static constexpr int CacheMaxPages = 5;
+    static constexpr qreal FastDpi = 216.0;
+    static constexpr qreal BaseDpi = 288.0;
+    static constexpr qreal MaxDpi = 600.0;
+    static constexpr int RerenderDelayMs = 200;
+    static constexpr int PageRenderDelayMs = 50;
+
+    void renderPage(int pageIndex);
+    void renderPageAsync(int pageIndex);
+    void onPageRenderFinished();
+    void onHiResRenderFinished();
+    void onHiResTimerTimeout();
+    void prefetchAdjacentPages();
+    void updateStatusText();
+    void startSpinner();
+    void stopSpinner();
+    qreal computeDisplayDpi(const QSizeF &pageSizePoints) const;
+
+    void cacheInsert(int pageIndex, const QImage &image);
+    QImage cacheLookup(int pageIndex);
+
+#ifdef HAVE_POPPLER
+    static void applyRenderHints(Poppler::Document *doc);
+#endif
+
+#ifdef HAVE_POPPLER
+    std::unique_ptr<Poppler::Document> m_document;
+    std::unique_ptr<Poppler::Page> m_page;
+    std::shared_ptr<Poppler::Document> m_bgDocument;
+#endif
+
+    QString m_filePath;
+    QImage m_currentImage;
+    int m_currentPage = 0;
+    int m_totalPages = 0;
+    qreal m_renderedDpi = 0.0;
+
+    // Display area for DPI computation
+    int m_areaWidth = 0;
+    int m_areaHeight = 0;
+    qreal m_devicePixelRatio = 1.0;
+
+    // Page cache (LRU)
+    QHash<int, QImage> m_pageCache;
+    QList<int> m_cacheLru;
+
+    // Async page rendering
+    QFutureWatcher<QImage> m_pageRenderWatcher;
+    int m_pageRenderTargetPage = -1;
+    bool m_pageRenderPending = false;
+
+    // Hi-res rerendering
+    QFutureWatcher<QImage> m_hiResRenderWatcher;
+    QTimer *m_hiResRenderTimer = nullptr;
+    qreal m_renderTargetDpi = 0.0;
+    int m_renderPageIndex = 0;
+    bool m_renderPending = false;
+    qreal m_lastZoomFactor = 1.0;
+
+    // Spinner
+    bool m_pageLoading = false;
+    qreal m_spinnerAngle = 0.0;
+    QTimer *m_spinnerTimer = nullptr;
+};
+
+#endif // QUICKLOOKPDFHANDLER_H
