+/*
+ * SPDX-FileCopyrightText: 2026 Pir0c0pter0
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "quicklookmediahandler.h"
+
+#include <QAudioBuffer>
+#include <QAudioDecoder>
+#include <QAudioOutput>
+#include <QMediaPlayer>
+#include <QMimeDatabase>
+#include <QMimeType>
+#include <QPainter>
+#include <QPainterPath>
+#include <QTimer>
+#include <QTransform>
+#include <QVideoFrame>
+#include <QVideoSink>
+#include <QtMath>
+
+#include <cmath>
+#include <complex>
+#include <vector>
+
+QuickLookMediaHandler::QuickLookMediaHandler(QObject *parent)
+    : QuickLookContentHandler(parent)
+{
+}
+
+QuickLookMediaHandler::~QuickLookMediaHandler()
+{
+    cleanup();
+}
+
+// ---------------------------------------------------------------------------
+// QuickLookContentHandler interface
+// ---------------------------------------------------------------------------
+
+QuickLookContentHandler::Kind QuickLookMediaHandler::kind() const
+{
+    return m_contentType == ContentType::Video ? Kind::Video : Kind::Audio;
+}
+
+bool QuickLookMediaHandler::open(const QUrl &url)
+{
+    if (!isReadableLocalFile(url)) {
+        Q_EMIT loadFailed();
+        return false;
+    }
+    QMimeDatabase db;
+    const QMimeType mt = db.mimeTypeForUrl(url);
+    const QString name = mt.name();
+    if (name.startsWith(QLatin1String("video/"))) {
+        setupVideo(url);
+    } else if (name.startsWith(QLatin1String("audio/"))) {
+        setupAudio(url);
+    } else {
+        Q_EMIT loadFailed();
+        return false;
+    }
+    return true;
+}
+
+void QuickLookMediaHandler::close()
+{
+    cleanup();
+}
+
+bool QuickLookMediaHandler::isReady() const
+{
+    return m_phase != Phase::Loading;
+}
+
+QString QuickLookMediaHandler::statusText() const
+{
+    return m_statusText;
+}
+
+QSizeF QuickLookMediaHandler::logicalContentSize() const
+{
+    if (m_contentType == ContentType::Video && m_videoSink) {
+        const QSize s = m_videoSink->videoSize();
+        if (s.isValid()) {
+            return QSizeF(s);
+        }
+    }
+    if (m_contentType == ContentType::Audio && !m_audioFrame.isNull()) {
+        return QSizeF(m_audioFrame.size());
+    }
+    return QSizeF();
+}
+
+void QuickLookMediaHandler::setViewportSize(const QSize &size)
+{
+    m_viewportSize = size;
+}
+
+void QuickLookMediaHandler::computeFFT(std::vector<std::complex<float>> &data)
+{
+    const int n = static_cast<int>(data.size());
+    Q_ASSERT((n & (n - 1)) == 0 && "FFT size must be a power of 2");
+    if (n <= 1) {
+        return;
+    }
+
+    for (int i = 1, j = 0; i < n; i++) {
+        int bit = n >> 1;
+        for (; j & bit; bit >>= 1) {
+            j ^= bit;
+        }
+        j ^= bit;
+        if (i < j) {
+            std::swap(data[i], data[j]);
+        }
+    }
+
+    for (int len = 2; len <= n; len <<= 1) {
+        const auto angle = static_cast<float>(-2.0 * M_PI / len);
+        const std::complex<float> wn(std::cos(angle), std::sin(angle));
+        for (int i = 0; i < n; i += len) {
+            std::complex<float> w(1.0f);
+            for (int j = 0; j < len / 2; j++) {
+                auto u = data[i + j];
+                auto v = data[i + j + len / 2] * w;
+                data[i + j] = u + v;
+                data[i + j + len / 2] = u - v;
+                w *= wn;
+            }
+        }
+    }
+}
+
+QVector<float> QuickLookMediaHandler::computeSpectrum(const QVector<float> &samples, int offset, int windowSize, int numBars)
+{
+    std::vector<std::complex<float>> fftData(windowSize);
+
+    for (int i = 0; i < windowSize; i++) {
+        int idx = offset - windowSize / 2 + i;
+        float sample = (idx >= 0 && idx < samples.size()) ? samples[idx] : 0.0f;
+        float window = 0.5f * (1.0f - std::cos(2.0f * static_cast<float>(M_PI) * i / (windowSize - 1)));
+        fftData[i] = std::complex<float>(sample * window, 0.0f);
+    }
+
+    computeFFT(fftData);
+
+    QVector<float> bars(numBars, 0.0f);
+    const int halfN = windowSize / 2;
+
+    for (int i = 0; i < numBars; i++) {
+        float t0 = static_cast<float>(i) / numBars;
+        float t1 = static_cast<float>(i + 1) / numBars;
+        int bin0 = qMax(1, static_cast<int>(1.0f + (halfN - 1.0f) * t0 * t0));
+        int bin1 = qMax(bin0 + 1, static_cast<int>(1.0f + (halfN - 1.0f) * t1 * t1));
+        bin1 = qMin(bin1, halfN);
+
+        float sum = 0.0f;
+        int count = 0;
+        for (int b = bin0; b < bin1; b++) {
+            sum += std::abs(fftData[b]);
+            count++;
+        }
+        bars[i] = count > 0 ? sum / count : 0.0f;
+    }
+
+    float maxVal = 0.001f;
+    for (const auto &v : bars) {
+        maxVal = qMax(maxVal, v);
+    }
+    for (auto &v : bars) {
+        v /= maxVal;
+    }
+
+    return bars;
+}
+
+QImage QuickLookMediaHandler::generateVinylImage(int size)
+{
+    QImage image(size, size, QImage::Format_RGBA8888);
+    image.fill(Qt::transparent);
+
+    QPainter p(&image);
+    p.setRenderHint(QPainter::Antialiasing);
+
+    const qreal cx = size / 2.0;
+    const qreal cy = size / 2.0;
+    const qreal outerR = (size - 4) / 2.0;
+    const qreal labelR = outerR * 0.33;
+    const qreal holeR = outerR * 0.025;
+
+    // Main vinyl disc
+    QRadialGradient discGrad(cx, cy, outerR);
+    discGrad.setColorAt(0.0, QColor(40, 40, 40));
+    discGrad.setColorAt(0.25, QColor(25, 25, 25));
+    discGrad.setColorAt(0.5, QColor(18, 18, 18));
+    discGrad.setColorAt(0.75, QColor(28, 28, 28));
+    discGrad.setColorAt(1.0, QColor(15, 15, 15));
+
+    p.setPen(Qt::NoPen);
+    p.setBrush(discGrad);
+    p.drawEllipse(QPointF(cx, cy), outerR, outerR);
+
+    // Light reflection highlight
+    QRadialGradient highlight(cx - outerR * 0.3, cy - outerR * 0.3, outerR * 1.2);
+    highlight.setColorAt(0.0, QColor(255, 255, 255, 18));
+    highlight.setColorAt(0.4, QColor(255, 255, 255, 6));
+    highlight.setColorAt(1.0, QColor(0, 0, 0, 0));
+    p.setBrush(highlight);
+    p.drawEllipse(QPointF(cx, cy), outerR, outerR);
+
+    // Groove lines
+    p.setBrush(Qt::NoBrush);
+    for (qreal r = labelR + 8; r < outerR - 4; r += 2.5) {
+        int brightness = 30 + static_cast<int>(12 * std::sin(r * 0.25));
+        int alpha = 35 + static_cast<int>(15 * std::cos(r * 0.12));
+        QPen groovePen(QColor(brightness, brightness, brightness, alpha), 0.7);
+        p.setPen(groovePen);
+        p.drawEllipse(QPointF(cx, cy), r, r);
+    }
+
+    // Edge bevel
+    QPen edgePen(QColor(55, 55, 55, 100), 1.5);
+    p.setPen(edgePen);
+    p.setBrush(Qt::NoBrush);
+    p.drawEllipse(QPointF(cx, cy), outerR, outerR);
+
+    // Green center label
+    QPainterPath labelClip;
+    labelClip.addEllipse(QPointF(cx, cy), labelR, labelR);
+    p.setClipPath(labelClip);
+
+    QConicalGradient cloudGrad(cx, cy, 45);
+    cloudGrad.setColorAt(0.0, QColor(80, 210, 50));
+    cloudGrad.setColorAt(0.15, QColor(50, 180, 30));
+    cloudGrad.setColorAt(0.35, QColor(90, 200, 60));
+    cloudGrad.setColorAt(0.5, QColor(40, 170, 25));
+    cloudGrad.setColorAt(0.7, QColor(70, 220, 45));
+    cloudGrad.setColorAt(0.85, QColor(45, 160, 30));
+    cloudGrad.setColorAt(1.0, QColor(80, 210, 50));
+
+    p.setPen(Qt::NoPen);
+    p.setBrush(cloudGrad);
+    p.drawEllipse(QPointF(cx, cy), labelR, labelR);
+
+    // Depth overlay
+    QRadialGradient depthGrad(cx - labelR * 0.2, cy - labelR * 0.25, labelR * 1.1);
+    depthGrad.setColorAt(0.0, QColor(255, 255, 255, 35));
+    depthGrad.setColorAt(0.4, QColor(0, 0, 0, 0));
+    depthGrad.setColorAt(0.8, QColor(0, 0, 0, 30));
+    depthGrad.setColorAt(1.0, QColor(0, 0, 0, 50));
+    p.setBrush(depthGrad);
+    p.drawEllipse(QPointF(cx, cy), labelR, labelR);
+
+    p.setClipping(false);
+
+    // Green center edge ring
+    QPen labelEdge(QColor(35, 200, 35, 180), 2.0);
+    p.setPen(labelEdge);
+    p.setBrush(Qt::NoBrush);
+    p.drawEllipse(QPointF(cx, cy), labelR, labelR);
+
+    // Center spindle hole
+    p.setPen(Qt::NoPen);
+    p.setBrush(QColor(8, 8, 8));
+    p.drawEllipse(QPointF(cx, cy), holeR, holeR);
+    QPen holePen(QColor(60, 60, 60, 120), 0.5);
+    p.setPen(holePen);
+    p.setBrush(Qt::NoBrush);
+    p.drawEllipse(QPointF(cx, cy), holeR, holeR);
+
+    p.end();
+    return image;
+}
+
+void QuickLookMediaHandler::setupVideo(const QUrl &fileUrl)
+{
+    cleanup();
+
+    m_contentType = ContentType::Video;
+    m_phase = Phase::Loading;
+    m_terminalDelivered = false;
+    m_readyDelivered = false;
+    const quint64 generation = m_generation;
+
+    m_audioOutput = new QAudioOutput(this);
+    m_audioOutput->setVolume(DefaultVolume);
+
+    m_mediaPlayer = new QMediaPlayer(this);
+    m_mediaPlayer->setAudioOutput(m_audioOutput);
+
+    m_videoSink = new QVideoSink(this);
+    m_mediaPlayer->setVideoOutput(m_videoSink);
+
+    m_mediaPlayer->setSource(fileUrl);
+    m_mediaPlayer->setLoops(QMediaPlayer::Infinite);
+
+    m_videoLoadTimer = new QTimer(this);
+    m_videoLoadTimer->setSingleShot(true);
+    connect(m_videoLoadTimer, &QTimer::timeout, this, [this, generation]() {
+        if (m_phase == Phase::Loading) {
+            failOnce(generation);
+        }
+    });
+    m_videoLoadTimer->start(VideoLoadTimeoutMs);
+
+    connect(m_mediaPlayer, &QMediaPlayer::errorOccurred, this, [this, generation]() {
+        failOnce(generation);
+    });
+
+    connect(m_videoSink, &QVideoSink::videoFrameChanged, this, [this, generation](const QVideoFrame &frame) {
+        if (generation == m_generation) {
+            onVideoFrameChanged(frame);
+        }
+    });
+
+    m_mediaPlayer->play();
+}
+
+void QuickLookMediaHandler::setupAudio(const QUrl &fileUrl)
+{
+    cleanup();
+
+    m_contentType = ContentType::Audio;
+    m_phase = Phase::Animating;
+    m_terminalDelivered = false;
+    m_readyDelivered = false;
+    const quint64 generation = m_generation;
+    m_vinylAngle = 0.0;
+    m_audioSamples.clear();
+    m_audioDecodingDone = false;
+    m_smoothedSpectrum.clear();
+
+    // Generate vinyl image (cached)
+    const int viewportSide = qMin(m_viewportSize.width(), m_viewportSize.height());
+    m_audioComposeSize = qBound(AudioComposeMinSize, viewportSide > 0 ? viewportSide : AudioComposeMaxSize, AudioComposeMaxSize);
+    if (m_vinylImage.size() != QSize(m_audioComposeSize, m_audioComposeSize)) {
+        m_vinylImage = generateVinylImage(m_audioComposeSize);
+    }
+
+    // Set up audio playback
+    m_audioOutput = new QAudioOutput(this);
+    m_audioOutput->setVolume(DefaultVolume);
+
+    m_mediaPlayer = new QMediaPlayer(this);
+    m_mediaPlayer->setAudioOutput(m_audioOutput);
+    m_mediaPlayer->setSource(fileUrl);
+    m_mediaPlayer->setLoops(QMediaPlayer::Infinite);
+
+    // Status text with playback time
+    connect(m_mediaPlayer, &QMediaPlayer::positionChanged, this, [this, generation](qint64 position) {
+        if (generation == m_generation) {
+            onPlaybackPositionChanged(position);
+        }
+    });
+
+    // Audio decoder for spectrum
+    m_audioDecoder = new QAudioDecoder(this);
+    QAudioFormat format;
+    format.setSampleRate(44100);
+    format.setChannelCount(1);
+    format.setSampleFormat(QAudioFormat::Float);
+    m_audioDecoder->setAudioFormat(format);
+    m_audioDecoder->setSource(fileUrl);
+    m_audioSampleRate = 44100;
+
+    connect(m_audioDecoder, &QAudioDecoder::bufferReady, this, [this, generation]() {
+        if (generation != m_generation || m_phase == Phase::Closing) {
+            return;
+        }
+        if (m_audioSamples.size() >= MaxAudioDecodeSamples) {
+            // Drain and stop — prevents internal buffer queue from growing unbounded on long files
+            m_audioDecoder->stop();
+            m_audioDecodingDone = true;
+            return;
+        }
+        const QAudioBuffer buffer = m_audioDecoder->read();
+        if (!buffer.isValid()) {
+            return;
+        }
+        const QAudioFormat bufferFormat = buffer.format();
+        if (!bufferFormat.isValid() || bufferFormat.sampleFormat() != QAudioFormat::Float || bufferFormat.channelCount() != 1
+            || bufferFormat.sampleRate() <= 0) {
+            return;
+        }
+        const float *data = buffer.constData<float>();
+        if (!data) {
+            return;
+        }
+        m_audioSampleRate = bufferFormat.sampleRate();
+        const int count = buffer.sampleCount();
+        for (int i = 0; i < count && m_audioSamples.size() < MaxAudioDecodeSamples; i++) {
+            m_audioSamples.append(data[i]);
+        }
+    });
+
+    connect(m_audioDecoder, &QAudioDecoder::finished, this, [this, generation]() {
+        if (generation == m_generation) {
+            m_audioDecodingDone = true;
+        }
+    });
+
+    connect(m_audioDecoder, qOverload<QAudioDecoder::Error>(&QAudioDecoder::error), this, [this, generation]() {
+        if (generation == m_generation) {
+            m_audioDecodingDone = true;
+        }
+    });
+
+    m_audioSamples.reserve(MaxAudioDecodeSamples);
+    m_audioDecoder->start();
+
+    // Emit the static vinyl as initial frame
+    emitReadyOnce(generation, m_vinylImage);
+}
+
+void QuickLookMediaHandler::cleanup()
+{
+    if (m_phase == Phase::Closing && !m_mediaPlayer && !m_videoSink && !m_audioOutput && !m_audioDecoder && !m_videoLoadTimer && !m_vinylTimer) {
+        return;
+    }
+    m_phase = Phase::Closing;
+    ++m_generation;
+    m_terminalDelivered = true;
+    cleanupVideo();
+    cleanupAudio();
+}
+
+void QuickLookMediaHandler::cleanupVideo()
+{
+    if (m_videoLoadTimer) {
+        m_videoLoadTimer->stop();
+        m_videoLoadTimer->deleteLater();
+        m_videoLoadTimer = nullptr;
+    }
+    // Tear down the media trio unconditionally. Guarding on m_contentType ==
+    // Video was dropped because audio-then-video previews leak the previous
+    // Audio-era trio (the guard is false on the cross-over path).
+    if (m_mediaPlayer) {
+        m_mediaPlayer->stop();
+        disconnect(m_mediaPlayer, nullptr, this, nullptr);
+        m_mediaPlayer->deleteLater();
+        m_mediaPlayer = nullptr;
+    }
+    if (m_videoSink) {
+        disconnect(m_videoSink, nullptr, this, nullptr);
+        m_videoSink->deleteLater();
+        m_videoSink = nullptr;
+    }
+    if (m_audioOutput) {
+        m_audioOutput->deleteLater();
+        m_audioOutput = nullptr;
+    }
+    m_videoFramePending = false;
+}
+
+void QuickLookMediaHandler::cleanupAudio()
+{
+    if (m_vinylTimer) {
+        m_vinylTimer->stop();
+        m_vinylTimer->deleteLater();
+        m_vinylTimer = nullptr;
+    }
+    if (m_audioDecoder) {
+        // Disconnect first so any buffered bufferReady/finished/error signals
+        // queued between stop() and the deleteLater tick cannot re-enter the
+        // lambdas with m_audioDecoder already cleared.
+        disconnect(m_audioDecoder, nullptr, this, nullptr);
+        m_audioDecoder->stop();
+        m_audioDecoder->deleteLater();
+        m_audioDecoder = nullptr;
+    }
+    if (m_mediaPlayer) {
+        m_mediaPlayer->stop();
+        disconnect(m_mediaPlayer, nullptr, this, nullptr);
+        m_mediaPlayer->deleteLater();
+        m_mediaPlayer = nullptr;
+    }
+    if (m_audioOutput) {
+        m_audioOutput->deleteLater();
+        m_audioOutput = nullptr;
+    }
+    m_audioSamples.clear();
+    m_audioSamples.squeeze();
+    m_audioFrame = QImage();
+    // Release the cached vinyl bitmap so Dolphin windows that never open
+    // another audio file don't retain ~2.5 MB for the life of the process.
+    m_vinylImage = QImage();
+    m_smoothedSpectrum.clear();
+    m_smoothedSpectrum.squeeze();
+    m_audioDecodingDone = false;
+}
+
+void QuickLookMediaHandler::pause()
+{
+    if (m_mediaPlayer) {
+        m_mediaPlayer->pause();
+    }
+    if (m_vinylTimer) {
+        m_vinylTimer->stop();
+    }
+}
+
+void QuickLookMediaHandler::play()
+{
+    if (m_mediaPlayer) {
+        m_mediaPlayer->play();
+    }
+}
+
+void QuickLookMediaHandler::onShowAnimationFinished()
+{
+    if (m_contentType == ContentType::Video && m_phase == Phase::Animating && m_mediaPlayer) {
+        m_phase = Phase::Playing;
+        m_mediaPlayer->play();
+    }
+
+    if (m_contentType == ContentType::Audio && m_phase == Phase::Animating && m_mediaPlayer) {
+        m_phase = Phase::Playing;
+        m_mediaPlayer->play();
+
+        if (!m_vinylTimer) {
+            m_vinylTimer = new QTimer(this);
+            connect(m_vinylTimer, &QTimer::timeout, this, [this]() {
+                if (m_phase != Phase::Playing) {
+                    return;
+                }
+                m_vinylAngle += VinylDegreesPerFrame;
+                if (m_vinylAngle >= 360.0) {
+                    m_vinylAngle -= 360.0;
+                }
+                composeAudioFrame();
+            });
+        }
+        if (animationsEnabled()) {
+            m_vinylTimer->start(AudioFrameIntervalMs);
+        }
+    }
+}
+
+void QuickLookMediaHandler::setClosing()
+{
+    // Release the media pipeline right away. The overlay keeps the last rendered
+    // frame in its own QImage/QPixmap for the hide animation, so we don't need to
+    // keep QMediaPlayer/QVideoSink/QAudioDecoder alive during fade-out.
+    cleanup();
+}
