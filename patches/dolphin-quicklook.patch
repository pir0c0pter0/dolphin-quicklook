+QuickLookOverlay::Private::Private(QuickLookOverlay *q)
+    : q(q)
+{
+    m_imageHandler = new QuickLookImageHandler(q);
+    QObject::connect(m_imageHandler, &QuickLookContentHandler::contentReady, q, [this](const QImage &image) {
+        if (!m_active || m_contentType != QuickLookContentKind::Image) {
+            return;
+        }
+        setContentImage(image);
+        m_hasAlphaChannel = image.hasAlphaChannel();
+        setStatusText({});
+        updatePixmap();
+    });
+    QObject::connect(m_imageHandler, &QuickLookContentHandler::loadFailed, q, [this]() {
+        if (m_active && m_contentType == QuickLookContentKind::Image) {
+            closeImmediately();
+        }
+    });
+    QObject::connect(m_imageHandler, &QuickLookContentHandler::crossfadeReady, q, [this, q = this->q](const QImage &newImage, const QImage &oldImage) {
+        if (!m_active || m_contentType != QuickLookContentKind::Image) {
+            return;
+        }
+        startCrossfade(newImage, oldImage);
+    });
+    QObject::connect(m_imageHandler, &QuickLookImageHandler::hiResRenderStarted, q, [this, q = this->q]() {
+        if (!m_active || m_contentType != QuickLookContentKind::Image) {
+            return;
+        }
+        m_frameTimer->start();
+    });
+
+    m_frameTimer = new QTimer(q);
+    m_frameTimer->setInterval(FrameIntervalMs);
+    QObject::connect(m_frameTimer, &QTimer::timeout, q, [this, q = this->q]() { advanceFrame(); });
+
+    const int styleDuration = q->style()->styleHint(QStyle::SH_Widget_Animation_Duration, nullptr, q);
+    // Breeze maps KDE's global animation-speed setting to this style hint.
+    // Keeping the private rendering library on the style API also avoids a
+    // reverse dependency on Dolphin's executable-only GlobalConfig symbol.
+    m_animDuration = qMax(0, styleDuration);
+    m_zoomAnimDuration = m_animDuration;
+    m_hiResCrossfadeDuration = m_animDuration > 0 ? qMax(1, m_animDuration * 3 / 5) : 0;
+    m_imageHandler->setAnimationsEnabled(m_animDuration > 0);
+
+#ifdef HAVE_QTPDF
+    m_pdfHandler = new QuickLookPdfHandler(q);
+    m_pdfHandler->setAnimationsEnabled(m_animDuration > 0);
+    QObject::connect(m_pdfHandler, &QuickLookPdfHandler::contentReady, q, [this, q = this->q](const QImage &image) {
+        if (!m_active || m_contentType != QuickLookContentKind::Pdf) {
+            return;
+        }
+        setContentImage(image);
+        m_pdfPageLogicalSize = m_pdfHandler->pageLogicalSize();
+        updatePixmap();
+    });
+    QObject::connect(m_pdfHandler, &QuickLookPdfHandler::crossfadeReady, q, [this, q = this->q](const QImage &newImage, const QImage &oldImage) {
+        if (!m_active || m_contentType != QuickLookContentKind::Pdf) {
+            return;
+        }
+        m_pdfPageLogicalSize = m_pdfHandler->pageLogicalSize();
+        startCrossfade(newImage, oldImage);
+    });
+    QObject::connect(m_pdfHandler, &QuickLookPdfHandler::requestUpdate, q, QOverload<>::of(&QWidget::update));
+    QObject::connect(m_pdfHandler, &QuickLookPdfHandler::hiResRenderStarted, q, [this, q = this->q]() {
+        if (!m_active || m_contentType != QuickLookContentKind::Pdf) {
+            return;
+        }
+        m_frameTimer->start();
+    });
+    QObject::connect(m_pdfHandler, &QuickLookPdfHandler::asyncLoadReady, q, [this, q = this->q](QuickLookPdfHandler::LoadResult result) {
+        if (!m_active || m_contentType != QuickLookContentKind::Pdf) {
+            return;
+        }
+        if (result == QuickLookPdfHandler::LoadResult::Success) {
+            setStatusText(m_pdfHandler->statusText());
+            q->update();
+        } else if (result == QuickLookPdfHandler::LoadResult::PasswordRequired) {
+            bool ok = false;
+            for (int attempt = 0; attempt < 3; ++attempt) {
+                const QString title = attempt == 0 ? i18n("Protected PDF") : i18n("Protected PDF — Wrong password");
+                const QString password =
+                    QInputDialog::getText(q->parentWidget(), title, i18n("Enter password to open this PDF:"), QLineEdit::Password, QString(), &ok);
+
+                if (!ok || password.isEmpty()) {
+                    break;
+                }
+
+                if (m_pdfHandler->unlockWithPassword(password)) {
+                    setStatusText(m_pdfHandler->statusText());
+                    updatePixmap();
+                    q->update();
+                    return;
+                }
+            }
+            // Failed to unlock — close overlay
+            closeImmediately();
+        } else {
+            // Load failed — close overlay
+            closeImmediately();
+        }
+    });
+#endif
+
+#ifdef HAVE_QTMULTIMEDIA
+    m_mediaHandler = new QuickLookMediaHandler(q);
+    m_mediaHandler->setAnimationsEnabled(m_animDuration > 0);
+    QObject::connect(m_mediaHandler, &QuickLookMediaHandler::contentReady, q, [this, q = this->q](const QImage &image) {
+        if (!m_active || (m_contentType != QuickLookContentKind::Video && m_contentType != QuickLookContentKind::Audio)) {
+            return;
+        }
+        setContentImage(image);
+        updatePixmap();
+        m_mediaHandler->markFrameConsumed();
+        q->update();
+    });
+    QObject::connect(m_mediaHandler, &QuickLookMediaHandler::readyToAnimate, q, [this, q = this->q](const QImage &firstFrame) {
+        if (!m_active || (m_contentType != QuickLookContentKind::Video && m_contentType != QuickLookContentKind::Audio)) {
+            return;
+        }
+        setContentImage(firstFrame);
+        setStatusText(m_mediaHandler->statusText());
+        updatePixmap();
+
+        if (!q->parentWidget()) {
+            return;
+        }
+        q->move(0, 0);
+        q->resize(q->parentWidget()->size());
+
+        q->show();
+        q->raise();
+        q->setFocus();
+        updatePixmap();
+        startShowAnimation();
+    });
+    QObject::connect(m_mediaHandler, &QuickLookMediaHandler::loadFailed, q, [this, q = this->q]() {
+        if (!m_active || (m_contentType != QuickLookContentKind::Video && m_contentType != QuickLookContentKind::Audio)) {
+            return;
+        }
+        closeImmediately();
+    });
+    QObject::connect(m_mediaHandler, &QuickLookMediaHandler::statusTextChanged, q, [this, q = this->q](const QString &text) {
+        if (!m_active || (m_contentType != QuickLookContentKind::Video && m_contentType != QuickLookContentKind::Audio)) {
+            return;
+        }
+        setStatusText(text);
+    });
+#endif
+
+    q->hide();
+}
+
+QuickLookOverlay::Private::~Private()
+{
+    // Disconnect handler signals before they (or any queued emissions) can
+    // re-enter the overlay during child destruction. Qt destroys children in
+    // reverse construction order, so a queued signal from a handler that is
+    // still alive could otherwise dispatch a lambda after the overlay has
+    // released resources the lambda would read.
+    if (m_imageHandler) {
+        QObject::disconnect(m_imageHandler, nullptr, q, nullptr);
+    }
+#ifdef HAVE_QTPDF
+    if (m_pdfHandler) {
+        QObject::disconnect(m_pdfHandler, nullptr, q, nullptr);
+    }
+#endif
+#ifdef HAVE_QTMULTIMEDIA
+    if (m_mediaHandler) {
+        QObject::disconnect(m_mediaHandler, nullptr, q, nullptr);
+    }
+#endif
+    if (m_frameTimer) {
+        m_frameTimer->stop();
+    }
+}
+
+// --- Lifecycle ---
+
+bool QuickLookOverlay::Private::showPreview(const QUrl &fileUrl)
+{
+    if (!QuickLookContentHandler::isReadableLocalFile(fileUrl)) {
+        return false;
+    }
+
+    // Cancel any in-flight async renders
+    m_imageHandler->close();
+
+#ifdef HAVE_QTPDF
+    m_pdfHandler->cancelPendingRenders();
+#endif
+
+    // If a hide animation was in progress, clean up
+    if (m_animating && !m_animForward) {
+        m_animating = false;
+        releaseContent();
+    } else {
+        m_animating = false;
+    }
+
+    const QString filePath = fileUrl.toLocalFile();
+    QMimeDatabase mimeDb;
+    const QString mimeType = mimeDb.mimeTypeForFile(filePath).name();
+
+    bool loaded = false;
+
+    if (mimeType.startsWith(QLatin1String("image/"))) {
+        loaded = loadImage(fileUrl);
+    } else if (mimeType == QLatin1String("application/pdf")) {
+        return loadPdfPreview(filePath, fileUrl);
+    }
+#ifdef HAVE_QTMULTIMEDIA
+    else if (mimeType.startsWith(QLatin1String("video/"))) {
+        return loadMediaPreview(fileUrl, QuickLookContentKind::Video);
+    } else if (mimeType.startsWith(QLatin1String("audio/"))) {
+        return loadMediaPreview(fileUrl, QuickLookContentKind::Audio);
+    }
+#endif
+
+    if (!loaded) {
+        return false;
+    }
+
+    activateAndShow(fileUrl);
+    return true;
+}
+
+void QuickLookOverlay::Private::hidePreview()
+{
+    if (!m_active) {
+        return;
+    }
+
+    if (m_activeHandler) {
+        m_activeHandler->setClosing();
+    }
+
+    startHideAnimation();
+}
+
+void QuickLookOverlay::Private::closeImmediately()
+{
+    m_active = false;
+    m_animating = false;
+    m_frameTimer->stop();
+    releaseContent();
+    q->hide();
+    Q_EMIT q->previewClosed();
+}
+
+void QuickLookOverlay::Private::releaseContent()
+{
+    m_contentImage = QImage();
+    m_pixmap = QPixmap();
+    m_crossfadeOldPixmap = QPixmap();
+    m_crossfadeOldImage = QImage();
+    if (m_imageHandler) {
+        m_imageHandler->close();
+    }
+#ifdef HAVE_QTPDF
+    if (m_pdfHandler) {
+        m_pdfHandler->cleanup();
+    }
+    m_pdfPageLogicalSize = QSizeF();
+#endif
+#ifdef HAVE_QTMULTIMEDIA
+    if (m_mediaHandler) {
+        m_mediaHandler->cleanup();
+    }
+#endif
+    m_activeHandler = nullptr;
+}
+
+void QuickLookOverlay::Private::activateAndShow(const QUrl &fileUrl)
+{
+    m_currentUrl = fileUrl;
+    m_active = true;
+    resetZoom();
+
+    if (!q->parentWidget()) {
+        return;
+    }
+    q->move(0, 0);
+    q->resize(q->parentWidget()->size());
+
+    q->show();
+    q->raise();
+    q->setFocus();
+
+    updatePixmap();
+    startShowAnimation();
+}
+
+bool QuickLookOverlay::Private::loadImage(const QUrl &fileUrl)
+{
+    m_contentType = QuickLookContentKind::Image;
+    m_activeHandler = m_imageHandler;
+    m_contentImage = {};
+    m_hasAlphaChannel = false;
+    m_hiResCrossfading = false;
+    setStatusText(i18n("Loading…"));
+    m_imageHandler->setViewportSize(displayAreaPixels());
+    if (!m_imageHandler->open(fileUrl)) {
+        return false;
+    }
+
+    updatePixmap();
+    return true;
+}
+
+bool QuickLookOverlay::Private::loadPdfPreview(const QString &filePath, const QUrl &fileUrl)
+{
+#ifdef HAVE_QTPDF
+    m_contentType = QuickLookContentKind::Pdf;
+    m_hasAlphaChannel = false;
+    m_imageHandler->close();
+    m_activeHandler = m_pdfHandler;
+    setStatusText(i18n("Loading…"));
+    m_currentUrl = fileUrl;
+    m_active = true;
+    resetZoom();
+
+    if (!q->parentWidget()) {
+        return false;
+    }
+
+    q->move(0, 0);
+    q->resize(q->parentWidget()->size());
+
+    m_pdfHandler->setDisplayArea(q->width(), q->height(), q->devicePixelRatioF());
+
+    // Show overlay immediately with spinner — content arrives via async signal.
+    // Must happen before loadAsync(): loadAsync can synchronously emit
+    // asyncLoadReady (size cap, load error, PasswordRequired), whose handler
+    // may close the overlay via closeImmediately().
+    q->show();
+    q->raise();
+    q->setFocus();
+    startShowAnimation();
+
+    m_pdfHandler->loadAsync(filePath);
+
+    // loadAsync may have synchronously closed the overlay (e.g. password
+    // cancelled or load failed); do not resurrect it.
+    if (!m_active) {
+        return false;
+    }
+
+    return true;
+#else
+    Q_UNUSED(filePath)
+    Q_UNUSED(fileUrl)
+    return false;
+#endif
+}
+
+bool QuickLookOverlay::Private::loadMediaPreview(const QUrl &fileUrl, QuickLookContentKind type)
+{
+#ifdef HAVE_QTMULTIMEDIA
+    m_currentUrl = fileUrl;
+    m_active = true;
+    m_hasAlphaChannel = false;
+    m_contentType = type;
+    m_activeHandler = m_mediaHandler;
+    setStatusText(type == QuickLookContentKind::Audio ? i18n("Loading audio…") : i18n("Loading video…"));
+    resetZoom();
+
+    m_mediaHandler->setViewportSize(displayAreaPixels());
+
+    if (type == QuickLookContentKind::Video) {
+        if (q->parentWidget()) {
+            m_mediaHandler->setVideoDisplaySize(q->parentWidget()->size());
+        }
+        m_mediaHandler->setupVideo(fileUrl);
+    } else {
+        m_mediaHandler->setupAudio(fileUrl);
+    }
+    return true;
+#else
+    Q_UNUSED(fileUrl)
+    Q_UNUSED(type)
+    return false;
+#endif
+}
+
+// --- Painting helpers ---
+
+void QuickLookOverlay::Private::setContentImage(const QImage &image)
+{
+    m_contentImage = image;
+}
+
+void QuickLookOverlay::Private::setStatusText(const QString &text)
+{
+    m_statusText = text;
+    q->setAccessibleDescription(text);
+    q->update();
+}
+
+void QuickLookOverlay::Private::startCrossfade(const QImage &newImage, const QImage &oldImage)
+{
+    if (m_hiResCrossfadeDuration == 0) {
+        setContentImage(newImage);
+        updatePixmap();
+        m_hiResCrossfading = false;
+        return;
+    }
+    m_crossfadeOldImage = oldImage;
+    setContentImage(newImage);
+    const qreal dpr = q->devicePixelRatioF();
+    m_pixmap = QPixmap::fromImage(newImage);
+    m_pixmap.setDevicePixelRatio(dpr);
+    m_crossfadeOldPixmap = QPixmap::fromImage(oldImage);
+    m_crossfadeOldPixmap.setDevicePixelRatio(dpr);
+    m_hiResCrossfade = 0.0;
+    m_hiResCrossfading = true;
+    m_hiResFadeTimer.start();
+    m_frameTimer->start();
+}
+
+void QuickLookOverlay::Private::updatePixmap()
+{
+    if (m_contentImage.isNull()) {
+        m_pixmap = QPixmap();
+        return;
+    }
+    m_pixmap = QPixmap::fromImage(m_contentImage);
+    // Content is loaded/decoded at logical-size * DPR pixels; tell Qt so
+    // QPainter::drawPixmap(QPoint, ...) variants map correctly, and the
+    // rectangular overload doesn't over-stretch on HiDPI.
+    m_pixmap.setDevicePixelRatio(q->devicePixelRatioF());
+}
+
+void QuickLookOverlay::Private::drawRenderSpinner(QPainter &painter, const QRectF &contentRect)
+{
+    if (!isHiResRendering() || m_hiResSpinnerAngle == 0.0) {
+        return;
+    }
+
+    painter.save();
+
+    // Small corner spinner for all hi-res rerenders (images, PDF zoom, etc.)
+    // No dim overlay — avoids flicker during continuous zoom on large PDFs
+    constexpr qreal spinnerSize = 22.0;
+    constexpr qreal penWidth = 2.5;
+    constexpr int margin = 12;
+
+    const qreal cx = contentRect.right() - margin - spinnerSize / 2.0;
+    const qreal cy = contentRect.bottom() - margin - spinnerSize / 2.0;
+    const QRectF strokeRect(cx - spinnerSize / 2.0 + penWidth / 2.0, cy - spinnerSize / 2.0 + penWidth / 2.0, spinnerSize - penWidth, spinnerSize - penWidth);
+
+    painter.setOpacity(m_animationProgress * 0.7);
+
+    const QColor accent = q->palette().color(QPalette::Highlight);
+    QConicalGradient gradient(QPointF(cx, cy), m_hiResSpinnerAngle);
+    gradient.setColorAt(0.0, QColor(accent.red(), accent.green(), accent.blue(), 220));
+    gradient.setColorAt(0.6, QColor(accent.red(), accent.green(), accent.blue(), 30));
+    gradient.setColorAt(0.75, QColor(accent.red(), accent.green(), accent.blue(), 0));
+    gradient.setColorAt(1.0, QColor(accent.red(), accent.green(), accent.blue(), 0));
+
+    QPen spinnerPen(QBrush(gradient), penWidth, Qt::SolidLine, Qt::RoundCap);
+    painter.setPen(spinnerPen);
+    painter.setBrush(Qt::NoBrush);
+    painter.drawEllipse(strokeRect);
+    painter.restore();
+}
+
+void QuickLookOverlay::Private::drawPdfSpinner(QPainter &painter, const QRectF &contentRect)
+{
+#ifdef HAVE_QTPDF
+    if (m_contentType != QuickLookContentKind::Pdf || !m_pdfHandler->isPageLoading()) {
+        return;
+    }
+
+    const QPointF center = contentRect.center();
+    const QRectF spinnerRect(center.x() - PdfSpinnerSize / 2.0, center.y() - PdfSpinnerSize / 2.0, PdfSpinnerSize, PdfSpinnerSize);
+    const QRectF strokeRect = spinnerRect.adjusted(PdfSpinnerPenWidth / 2.0, PdfSpinnerPenWidth / 2.0, -PdfSpinnerPenWidth / 2.0, -PdfSpinnerPenWidth / 2.0);
+
+    // Smooth gradient spinner
+    painter.setOpacity(m_animationProgress * PdfSpinnerOpacity);
+    const QColor accent = q->palette().color(QPalette::Highlight);
+    QConicalGradient gradient(center, m_pdfHandler->spinnerAngle());
+    gradient.setColorAt(0.0, QColor(accent.red(), accent.green(), accent.blue(), PdfSpinnerGradientAlpha));
+    gradient.setColorAt(0.65, QColor(accent.red(), accent.green(), accent.blue(), PdfSpinnerGradientMidAlpha));
+    gradient.setColorAt(0.75, QColor(accent.red(), accent.green(), accent.blue(), 0));
+    gradient.setColorAt(1.0, QColor(accent.red(), accent.green(), accent.blue(), 0));
+
+    QPen spinnerPen(QBrush(gradient), PdfSpinnerPenWidth, Qt::SolidLine, Qt::RoundCap);
+    painter.setPen(spinnerPen);
+    painter.setBrush(Qt::NoBrush);
+    painter.drawEllipse(strokeRect);
+    painter.setOpacity(1.0);
+#else
+    Q_UNUSED(painter)
+    Q_UNUSED(contentRect)
+#endif
+}
+
+void QuickLookOverlay::Private::drawPdfArrows(QPainter &painter)
+{
+#ifdef HAVE_QTPDF
+    if (m_contentType != QuickLookContentKind::Pdf || m_pdfHandler->totalPages() <= 1) {
+        return;
+    }
+
+    // The arrow rects are assigned by paintEvent before this is called; bail
+    // out defensively if that ordering is ever broken by a refactor, so we
+    // don't draw a zero/negative-sized triangle from the default-constructed
+    // rect.
+    if (m_pdfArrowUpRect.isEmpty() || m_pdfArrowDownRect.isEmpty()) {
+        return;
+    }
+
+    const bool canGoUp = m_pdfHandler->currentPage() > 0 && !m_pdfHandler->isPageLoading();
+    const bool canGoDown = m_pdfHandler->currentPage() < m_pdfHandler->totalPages() - 1 && !m_pdfHandler->isPageLoading();
+    const int arrowSize = m_pdfArrowUpRect.width();
+
+    auto drawArrowButton = [&](const QRect &btnRect, bool enabled, bool pointsUp) {
+        const qreal btnOpacity = enabled ? PdfArrowEnabledOpacity : PdfArrowDisabledOpacity;
+        painter.setOpacity(m_animationProgress * btnOpacity);
+
+        painter.setPen(Qt::NoPen);
+        QColor buttonColor = q->palette().color(QPalette::Button);
+        buttonColor.setAlpha(PdfArrowBgAlpha);
+        painter.setBrush(buttonColor);
+        painter.drawRoundedRect(btnRect, PdfArrowBtnRadius, PdfArrowBtnRadius);
+
+        const int pad = PdfArrowInnerPad;
+        const QPointF c = QRectF(btnRect).center();
+        const int half = (arrowSize - 2 * pad) / 2;
+        QPolygonF triangle;
+        if (pointsUp) {
+            triangle << QPointF(c.x(), c.y() - half) << QPointF(c.x() - half, c.y() + half) << QPointF(c.x() + half, c.y() + half);
+        } else {
+            triangle << QPointF(c.x(), c.y() + half) << QPointF(c.x() - half, c.y() - half) << QPointF(c.x() + half, c.y() - half);
+        }
+        painter.setBrush(q->palette().color(QPalette::ButtonText));
+        painter.drawPolygon(triangle);
+    };
+
+    drawArrowButton(m_pdfArrowUpRect, canGoUp, true);
+    drawArrowButton(m_pdfArrowDownRect, canGoDown, false);
+
+    painter.setOpacity(1.0);
+#else
+    Q_UNUSED(painter)
+#endif
+}
+
+void QuickLookOverlay::Private::drawVideoProgressBar(QPainter &painter, const QRectF &contentRect)
+{
+#ifdef HAVE_QTMULTIMEDIA
+    if (m_contentType != QuickLookContentKind::Video || !m_mediaHandler || !m_mediaHandler->isPlaying()) {
+        return;
+    }
+
+    const qint64 dur = m_mediaHandler->duration();
+    if (dur <= 0) {
+        return;
+    }
+
+    const qint64 pos = m_mediaHandler->position();
+    const qreal progress = static_cast<qreal>(pos) / dur;
+
+    // Format time strings
+    auto formatTime = [](qint64 totalMs) -> QString {
+        const qint64 totalSec = totalMs / 1000;
+        const qint64 h = totalSec / 3600;
+        const qint64 m = (totalSec % 3600) / 60;
+        const qint64 s = totalSec % 60;
+        if (h > 0) {
+            return QStringLiteral("%1:%2:%3").arg(h).arg(m, 2, 10, QLatin1Char('0')).arg(s, 2, 10, QLatin1Char('0'));
+        }
+        return QStringLiteral("%1:%2").arg(m).arg(s, 2, 10, QLatin1Char('0'));
+    };
+
+    const QString timeText = formatTime(pos) + QStringLiteral(" / ") + formatTime(dur);
+
+    // Bar geometry — below the content rect
+    const qreal barY = contentRect.bottom() + ProgressBarBottomMargin;
+    const qreal barX = contentRect.left() + ProgressBarSideMargin;
+    const qreal barW = contentRect.width() - 2 * ProgressBarSideMargin;
+    const QRectF barRect(barX, barY, barW, ProgressBarHeight);
+
+    // Store for hit-testing (with padding)
+    m_videoProgressBarRect = barRect.adjusted(-ProgressBarHitPadding, -ProgressBarHitPadding, ProgressBarHitPadding, ProgressBarHitPadding);
+
+    // Background track
+    painter.setOpacity(m_animationProgress * 0.9);
+    painter.setPen(Qt::NoPen);
+    QColor trackColor = q->palette().color(QPalette::Mid);
+    trackColor.setAlpha(ProgressBarBgAlpha);
+    painter.setBrush(trackColor);
+    painter.drawRoundedRect(barRect, ProgressBarRadius, ProgressBarRadius);
+
+    // Filled portion
+    const QRectF fillRect(barX, barY, barW * progress, ProgressBarHeight);
+    QColor fillColor = q->palette().color(QPalette::Highlight);
+    fillColor.setAlpha(ProgressBarFillAlpha);
+    painter.setBrush(fillColor);
+    painter.drawRoundedRect(fillRect, ProgressBarRadius, ProgressBarRadius);
+
+    // Time text below bar
+    QFont timeFont = q->font();
+    timeFont.setPixelSize(ProgressTimeFontSize);
+    painter.setFont(timeFont);
+    QColor timeColor = q->palette().color(QPalette::BrightText);
+    timeColor.setAlpha(static_cast<int>(200 * m_animationProgress));
+    painter.setPen(timeColor);
+    const QRectF timeRect(barX, barRect.bottom() + ProgressTimeMargin, barW, ProgressTimeFontSize + 4);
+    painter.drawText(timeRect, Qt::AlignHCenter | Qt::AlignTop, timeText);
+
+    painter.setOpacity(1.0);
+#else
+    Q_UNUSED(painter)
+    Q_UNUSED(contentRect)
+#endif
+}
+
+void QuickLookOverlay::Private::paint(QPaintEvent *event)
+{
+    Q_UNUSED(event)
+
+    QPainter painter(q);
+    painter.setRenderHint(QPainter::Antialiasing);
+    painter.setRenderHint(QPainter::SmoothPixmapTransform);
+
+    // 1. Background dim (always draw when active)
+    painter.fillRect(q->rect(), QColor(0, 0, 0, static_cast<int>(BgAlphaMax * m_animationProgress)));
+
+    if (m_pixmap.isNull()) {
+        // Draw spinner during async PDF loading
+        drawPdfSpinner(painter, QRectF(q->rect()));
+        if (!m_statusText.isEmpty()) {
+            painter.setPen(q->palette().color(QPalette::BrightText));
+            painter.drawText(q->rect().adjusted(0, 0, 0, -ContentPadding), Qt::AlignHCenter | Qt::AlignBottom, m_statusText);
+        }
+        return;
+    }
+
+    // 2. Compute draw rect (scale + zoom + pan)
+    const QRectF base = baseContentRect();
+    const QPointF center = base.center();
+    bool videoPlaying = false;
+#ifdef HAVE_QTMULTIMEDIA
+    videoPlaying = (m_contentType == QuickLookContentKind::Video && m_mediaHandler && m_mediaHandler->isPlaying());
+#endif
+    const qreal scale = videoPlaying ? 1.0 : (ScaleAnimMin + ScaleAnimRange * m_animationProgress);
+    const qreal w = base.width() * scale * m_zoomFactor;
+    const qreal h = base.height() * scale * m_zoomFactor;
+    const QRectF drawRect(center.x() + m_panOffset.x() - w / 2.0, center.y() + m_panOffset.y() - h / 2.0, w, h);
+    const QRectF anchorRect(center.x() - w / 2.0, center.y() - h / 2.0, w, h);
+
+    // 3. Drop shadow (skip for alpha/audio/PDF content)
+    if (!m_hasAlphaChannel && m_contentType != QuickLookContentKind::Audio && m_contentType != QuickLookContentKind::Pdf) {
+        const int offset = static_cast<int>(ShadowOffset * m_animationProgress);
+        QColor shadowColor(0, 0, 0, static_cast<int>(ShadowAlphaMax * m_animationProgress));
+        painter.setPen(Qt::NoPen);
+        painter.setBrush(shadowColor);
+        painter.drawRoundedRect(drawRect.adjusted(offset, offset, offset, offset), CornerRadius, CornerRadius);
+    }
+
+    // 4. Content with rounded corners + crossfade. Wrap the whole block in
+    // save()/restore() so any opacity / clip state leaks cannot bleed into
+    // the subsequent spinner / arrows / progress-bar passes.
+    painter.save();
+    if (m_contentType == QuickLookContentKind::Audio) {
+        painter.setOpacity(m_animationProgress);
+        painter.drawPixmap(drawRect.toRect(), m_pixmap);
+    } else {
+        QPainterPath clipPath;
+        clipPath.addRoundedRect(drawRect, CornerRadius, CornerRadius);
+        painter.setOpacity(m_animationProgress);
+        painter.setClipPath(clipPath);
+
+        if (m_hiResCrossfading && !m_crossfadeOldPixmap.isNull()) {
+            painter.setOpacity(m_animationProgress * (1.0 - m_hiResCrossfade));
+            painter.drawPixmap(drawRect.toRect(), m_crossfadeOldPixmap);
+            painter.setOpacity(m_animationProgress * m_hiResCrossfade);
+            painter.drawPixmap(drawRect.toRect(), m_pixmap);
+        } else {
+            painter.drawPixmap(drawRect.toRect(), m_pixmap);
+        }
+    }
+    painter.restore();
+
+    // 5. Label text
+    QString labelText;
+    if constexpr (ShowFilename) {
+        labelText = m_currentUrl.fileName();
+    }
+    if (!m_statusText.isEmpty()) {
+        labelText += labelText.isEmpty() ? m_statusText : QStringLiteral(" — ") + m_statusText;
+    }
+    if (!labelText.isEmpty()) {
+        QFont labelFont = q->font();
+        labelFont.setBold(true);
+        QColor labelColor = q->palette().color(QPalette::BrightText);
+        labelColor.setAlpha(static_cast<int>(255 * m_animationProgress));
+        painter.setPen(labelColor);
+        painter.setFont(labelFont);
+        const QRect textRect(0, anchorRect.bottom() + TextSpacing, q->width(), TextHeight);
+        painter.drawText(textRect, Qt::AlignHCenter | Qt::AlignTop, labelText);
+    }
+
+    // 6. Video progress bar
+    drawVideoProgressBar(painter, drawRect);
+
+    // 7. PDF overlays
+    if (m_animationProgress > 0.5) {
+        // Update arrow rects for hit-testing
+#ifdef HAVE_QTPDF
+        if (m_contentType == QuickLookContentKind::Pdf && m_pdfHandler->totalPages() > 1) {
+            // Clamp arrowX to the widget width so the arrows can't fall off
+            // the overlay edge on very narrow windows where the content
+            // already fills most of the available space.
+            const int preferredX = static_cast<int>(anchorRect.right()) + PdfArrowMargin;
+            const int maxX = q->width() - PdfArrowSize - PdfArrowMargin;
+            const int arrowX = qMin(preferredX, qMax(0, maxX));
+            const int centerY = qRound(anchorRect.center().y());
+            m_pdfArrowUpRect = QRect(arrowX, centerY - PdfArrowSize - PdfArrowSpacing, PdfArrowSize, PdfArrowSize);
+            m_pdfArrowDownRect = QRect(arrowX, centerY + PdfArrowSpacing, PdfArrowSize, PdfArrowSize);
+        }
+#endif
+        drawPdfSpinner(painter, drawRect);
+        drawPdfArrows(painter);
+    }
+
+    // 8. Hi-res render spinner (zoom reprocessing indicator)
+    drawRenderSpinner(painter, drawRect);
+}
+
+// --- Geometry ---
+
+QRectF QuickLookOverlay::Private::baseContentRect() const
+{
+    const int maxW = q->width() - 2 * ContentPadding;
+    const int maxH = q->height() - 2 * ContentPadding - BottomExtraSpace;
+    if (maxW <= 0 || maxH <= 0) {
+        return {};
+    }
+
+    // Use stable logical size to prevent rect jumps during hi-res crossfade
+    QSizeF logicalSize;
+#ifdef HAVE_QTPDF
+    if (m_contentType == QuickLookContentKind::Pdf && m_pdfPageLogicalSize.isValid()) {
+        logicalSize = m_pdfPageLogicalSize;
+    } else
+#endif
+        if (m_contentType == QuickLookContentKind::Image && m_imageHandler && m_imageHandler->originalPixelSize().isValid()) {
+        logicalSize = QSizeF(m_imageHandler->originalPixelSize());
+    } else if (!m_contentImage.isNull()) {
+        logicalSize = QSizeF(m_contentImage.size());
+    } else {
+        return {};
+    }
+
+    logicalSize.scale(maxW, maxH, Qt::KeepAspectRatio);
+
+    const qreal x = (q->width() - logicalSize.width()) / 2.0;
+    const qreal y = (q->height() - logicalSize.height()) / 2.0 - ContentVerticalShift;
+
+    return {x, y, logicalSize.width(), logicalSize.height()};
+}
+
+QRect QuickLookOverlay::Private::scaledContentRect() const
+{
+    const QRectF base = baseContentRect();
+    if (base.isEmpty()) {
+        return {};
+    }
+
+    const qreal w = base.width() * m_zoomFactor;
+    const qreal h = base.height() * m_zoomFactor;
+    const qreal cx = base.center().x() + m_panOffset.x();
+    const qreal cy = base.center().y() + m_panOffset.y();
+
+    return QRectF(cx - w / 2.0, cy - h / 2.0, w, h).toRect();
+}
+
+QSize QuickLookOverlay::Private::displayAreaPixels() const
+{
+    int w = q->width();
+    int h = q->height();
+
+    // Before overlay is shown, use parent widget size
+    if (w <= 0 || h <= 0) {
+        if (q->parentWidget()) {
+            w = q->parentWidget()->width();
+            h = q->parentWidget()->height();
+        } else {
+            return {MaxImageWidth, MaxImageHeight};
+        }
+    }
+
+    // Clamp the logical dimensions to >= 0 *before* multiplying by the device
+    // pixel ratio: subtracting the content paddings can go negative on very
+    // narrow widgets, and static_cast<int> of a negative qreal is still
+    // negative — the old ``<= 0`` guard only caught an exact zero.
+    const int logicalW = qMax(0, w - 2 * ContentPadding);
+    const int logicalH = qMax(0, h - 2 * ContentPadding - BottomExtraSpace);
+    if (logicalW == 0 || logicalH == 0) {
+        return {MaxImageWidth, MaxImageHeight};
+    }
+
+    const qreal dpr = q->devicePixelRatioF();
+    const int maxW = static_cast<int>(logicalW * dpr);
+    const int maxH = static_cast<int>(logicalH * dpr);
+
+    if (maxW <= 0 || maxH <= 0) {
+        return {MaxImageWidth, MaxImageHeight};
+    }
+    return {maxW, maxH};
+}
+
+int QuickLookOverlay::Private::targetImageRenderWidth() const
+{
+    const QRectF base = baseContentRect();
+    if (base.isEmpty()) {
+        return 0;
+    }
+
+    const qreal dpr = q->devicePixelRatioF();
+    const int physicalWidth = static_cast<int>(base.width() * dpr * m_zoomFactor);
+
+    // Never exceed original image dimensions
+    const QSize origSize = m_imageHandler ? m_imageHandler->originalPixelSize() : QSize();
+    if (origSize.isValid()) {
+        return qMin(physicalWidth, origSize.width());
+    }
+    return physicalWidth;
+}
+
+// --- Animation ---
+
+void QuickLookOverlay::Private::startShowAnimation()
+{
+    m_animStartValue = m_animationProgress;
+    m_animEndValue = 1.0;
+    m_animForward = true;
+    m_animating = true;
+    if (m_animDuration == 0) {
+        m_animationProgress = 1.0;
+        m_animating = false;
+        onAnimationFinished();
+        q->update();
+        return;
+    }
+    m_animTimer.start();
+    m_frameTimer->start();
+}
+
+void QuickLookOverlay::Private::startHideAnimation()
+{
+    m_animStartValue = m_animationProgress;
+    m_animEndValue = 0.0;
+    m_animForward = false;
+    m_animating = true;
+    if (m_animDuration == 0) {
+        m_animationProgress = 0.0;
+        m_animating = false;
+        onAnimationFinished();
+        return;
+    }
+    m_animTimer.start();
+    m_frameTimer->start();
+}
+
+void QuickLookOverlay::Private::advanceFrame()
+{
+    advanceAnimation();
+    advanceZoomAnimation();
+    updateCrossfadeProgress();
+
+    if (isHiResRendering()) {
+        m_hiResSpinnerAngle += 15.0;
+        if (m_hiResSpinnerAngle >= 360.0) {
+            m_hiResSpinnerAngle -= 360.0;
+        }
+    } else if (m_hiResSpinnerAngle != 0.0) {
+        m_hiResSpinnerAngle = 0.0;
+        if (!m_animating && !m_zoomAnimating && !m_hiResCrossfading) {
+            m_frameTimer->stop();
+        }
+    }
+
+    q->update();
+}
+
+void QuickLookOverlay::Private::advanceAnimation()
+{
+    if (!m_animating) {
+        return;
+    }
+
+    const qreal elapsed = static_cast<qreal>(m_animTimer.elapsed());
+    const qreal duration = qMax(1.0, static_cast<qreal>(m_animDuration));
+    const qreal t = qBound(0.0, elapsed / duration, 1.0);
+    const qreal easedT = m_easingCurve.valueForProgress(t);
+    m_animationProgress = m_animStartValue + (m_animEndValue - m_animStartValue) * easedT;
+
+    if (t >= 1.0) {
+        m_animating = false;
+        onAnimationFinished();
+    }
+}
+
+void QuickLookOverlay::Private::advanceZoomAnimation()
+{
+    if (!m_zoomAnimating) {
+        return;
+    }
+
+    const qreal elapsed = static_cast<qreal>(m_zoomAnimTimer.elapsed());
+    const qreal duration = qMax(1.0, static_cast<qreal>(m_zoomAnimDuration));
+    const qreal t = qBound(0.0, elapsed / duration, 1.0);
+    const qreal easedT = m_easingCurve.valueForProgress(t);
+
+    m_zoomFactor = m_zoomAnimStartFactor + (1.0 - m_zoomAnimStartFactor) * easedT;
+    m_panOffset = m_zoomAnimStartPan * (1.0 - easedT);
+
+    if (t >= 1.0) {
+        m_zoomAnimating = false;
+        m_zoomFactor = 1.0;
+        m_panOffset = QPointF{};
+        q->setCursor(Qt::ArrowCursor);
+        scheduleHiResRerender();
+        if (!m_animating && !m_hiResCrossfading) {
+            m_frameTimer->stop();
+        }
+    }
+}
+
+void QuickLookOverlay::Private::onAnimationFinished()
+{
+    if (m_animForward) {
+        if (m_activeHandler) {
+            m_activeHandler->onShowAnimationFinished();
+        }
+    } else {
+        m_active = false;
+
+        releaseContent();
+        q->hide();
+        Q_EMIT q->previewClosed();
+    }
+
+    if (!m_animating && !m_zoomAnimating && !m_hiResCrossfading) {
+        m_frameTimer->stop();
+    }
+}
+
+void QuickLookOverlay::Private::animateZoomReset()
+{
+    if (m_zoomAnimDuration == 0) {
+        resetZoom();
+        scheduleHiResRerender();
+        q->update();
+        return;
+    }
+    m_zoomAnimStartFactor = m_zoomFactor;
+    m_zoomAnimStartPan = m_panOffset;
+    m_zoomAnimating = true;
+    m_zoomAnimTimer.start();
+    m_dragging = false;
+    m_frameTimer->start();
+}
+
+void QuickLookOverlay::Private::resetZoom()
+{
+    m_zoomFactor = 1.0;
+    m_panOffset = QPointF{};
+    m_dragging = false;
+    q->setCursor(Qt::ArrowCursor);
+}
+
+void QuickLookOverlay::Private::updateCrossfadeProgress()
+{
+    if (!m_hiResCrossfading) {
+        return;
+    }
+
+    const qreal elapsed = static_cast<qreal>(m_hiResFadeTimer.elapsed());
+    m_hiResCrossfade = qBound(0.0, elapsed / m_hiResCrossfadeDuration, 1.0);
+    if (m_hiResCrossfade >= 1.0) {
+        m_hiResCrossfading = false;
+        m_crossfadeOldImage = QImage();
+        m_crossfadeOldPixmap = QPixmap();
+        if (!m_animating && !m_zoomAnimating) {
+            m_frameTimer->stop();
+        }
+    }
+}
+
+bool QuickLookOverlay::Private::isHiResRendering() const
+{
+    if (m_contentType == QuickLookContentKind::Image && m_imageHandler && m_imageHandler->isHiResRendering()) {
+        return true;
+    }
+#ifdef HAVE_QTPDF
+    if (m_contentType == QuickLookContentKind::Pdf && m_pdfHandler && m_pdfHandler->isHiResRendering()) {
+        return true;
+    }
+#endif
+    return false;
+}
+
+void QuickLookOverlay::Private::scheduleHiResRerender()
+{
+    if (m_contentType == QuickLookContentKind::Pdf) {
+#ifdef HAVE_QTPDF
+        m_pdfHandler->setDisplayArea(q->width(), q->height(), q->devicePixelRatioF());
+        m_pdfHandler->scheduleHiResRerender(m_zoomFactor);
+#endif
+    } else if (m_contentType == QuickLookContentKind::Image && m_imageHandler) {
+        m_imageHandler->scheduleHiResRerender(targetImageRenderWidth());
+    }
+}
+
+// --- Event dispatch ---
+
+void QuickLookOverlay::Private::mouseDoubleClickEvent(QMouseEvent *event)
+{
+    Q_UNUSED(event)
+    hidePreview();
+}
+
+void QuickLookOverlay::Private::mousePressEvent(QMouseEvent *event)
+{
+#ifdef HAVE_QTMULTIMEDIA
+    if (event->button() == Qt::LeftButton && m_contentType == QuickLookContentKind::Video && m_mediaHandler && m_mediaHandler->isPlaying()
+        && m_videoProgressBarRect.contains(event->position())) {
+        const qint64 dur = m_mediaHandler->duration();
+        // Map click X to progress ratio within the actual bar (not the hit padding).
+        const qreal barX = m_videoProgressBarRect.left() + ProgressBarHitPadding;
+        const qreal barW = m_videoProgressBarRect.width() - 2 * ProgressBarHitPadding;
+        // Guard against zero-or-negative barW: on a very narrow window, the
+        // hit rect might shrink to nothing and dividing would produce NaN,
+        // which would then be cast to an unspecified qint64.
+        if (dur > 0 && barW > 0.0) {
+            const qreal ratio = qBound(0.0, (event->position().x() - barX) / barW, 1.0);
+            m_mediaHandler->seek(static_cast<qint64>(ratio * dur));
+        }
+        event->accept();
+        return;
+    }
+#endif
+
+#ifdef HAVE_QTPDF
+    if (event->button() == Qt::LeftButton && m_contentType == QuickLookContentKind::Pdf && m_pdfHandler->totalPages() > 1 && !m_pdfHandler->isPageLoading()) {
+        const QPoint pos = event->pos();
+        if (m_pdfArrowUpRect.contains(pos) && m_pdfHandler->currentPage() > 0) {
+            resetZoom();
+            m_pdfHandler->navigatePage(-1);
+            setStatusText(m_pdfHandler->statusText());
+            event->accept();
+            return;
+        }
+        if (m_pdfArrowDownRect.contains(pos) && m_pdfHandler->currentPage() < m_pdfHandler->totalPages() - 1) {
+            resetZoom();
+            m_pdfHandler->navigatePage(1);
+            setStatusText(m_pdfHandler->statusText());
+            event->accept();
+            return;
+        }
+    }
+#endif
+
+    if (event->button() == Qt::RightButton && m_zoomFactor > ZoomMin) {
+        animateZoomReset();
+        event->accept();
+        return;
+    }
+    if (event->button() == Qt::LeftButton && m_zoomFactor > ZoomMin) {
+        m_dragging = true;
+        m_lastMousePos = event->position();
+        q->setCursor(Qt::ClosedHandCursor);
+        event->accept();
+        return;
+    }
+    q->QWidget::mousePressEvent(event);
+}
+
+void QuickLookOverlay::Private::mouseMoveEvent(QMouseEvent *event)
+{
+    if (m_dragging) {
+        const QPointF delta = event->position() - m_lastMousePos;
+        m_panOffset += delta;
+        m_lastMousePos = event->position();
+        q->update();
+        event->accept();
+        return;
+    }
+    q->QWidget::mouseMoveEvent(event);
+}
+
+void QuickLookOverlay::Private::mouseReleaseEvent(QMouseEvent *event)
+{
+    if (event->button() == Qt::LeftButton && m_dragging) {
+        m_dragging = false;
+        q->setCursor(m_zoomFactor > ZoomMin ? Qt::OpenHandCursor : Qt::ArrowCursor);
+        event->accept();
+        return;
+    }
+    q->QWidget::mouseReleaseEvent(event);
+}
+
+void QuickLookOverlay::Private::wheelEvent(QWheelEvent *event)
+{
+    if (!m_active || m_animating || m_zoomAnimating || m_contentType == QuickLookContentKind::Audio) {
+        event->ignore();
+        return;
+    }
+
+    const QRect contentArea = scaledContentRect();
+    const QPointF cursorPos = event->position();
+    if (!contentArea.contains(cursorPos.toPoint())) {
+        event->accept();
+        return;
+    }
+
+    const qreal oldZoom = m_zoomFactor;
+    const qreal delta = event->angleDelta().y() > 0 ? ZoomStep : -ZoomStep;
+    m_zoomFactor = qBound(ZoomMin, m_zoomFactor + delta * m_zoomFactor, ZoomMax);
+
+    if (qFuzzyCompare(m_zoomFactor, oldZoom)) {
+        event->accept();
+        return;
+    }
+
+    const QRectF base = baseContentRect();
+    const QPointF baseCenter = base.center();
+    const qreal ratio = m_zoomFactor / oldZoom;
+    m_panOffset = (1.0 - ratio) * (cursorPos - baseCenter) + ratio * m_panOffset;
+
+    if (qFuzzyCompare(m_zoomFactor, ZoomMin)) {
+        m_panOffset = QPointF{};
+        q->setCursor(Qt::ArrowCursor);
+    } else {
+        q->setCursor(Qt::OpenHandCursor);
+    }
+
+    scheduleHiResRerender();
+
+    q->update();
+    event->accept();
+}
+
+void QuickLookOverlay::Private::keyPressEvent(QKeyEvent *event)
+{
+    if (event->key() == Qt::Key_Escape || event->key() == Qt::Key_Space) {
+        hidePreview();
+        event->accept();
+        return;
+    }
+
+#ifdef HAVE_QTPDF
+    if (m_contentType == QuickLookContentKind::Pdf && m_pdfHandler->totalPages() > 1) {
+        if (event->key() == Qt::Key_Up || event->key() == Qt::Key_PageUp) {
+            resetZoom();
+            m_pdfHandler->navigatePage(-1);
+            setStatusText(m_pdfHandler->statusText());
+            event->accept();
+            return;
+        }
+        if (event->key() == Qt::Key_Down || event->key() == Qt::Key_PageDown) {
+            resetZoom();
+            m_pdfHandler->navigatePage(1);
+            m_statusText = m_pdfHandler->statusText();
+            event->accept();
+            return;
+        }
+    }
+#endif
+
+    q->QWidget::keyPressEvent(event);
+}
+
+void QuickLookOverlay::Private::resizeEvent(QResizeEvent *event)
+{
+    q->QWidget::resizeEvent(event);
+#ifdef HAVE_QTPDF
+    if (m_pdfHandler) {
+        m_pdfHandler->setDisplayArea(q->width(), q->height(), q->devicePixelRatioF());
+    }
+#endif
+    q->update();
+}
+
+// ---------------------------------------------------------------------------
+// QuickLookOverlay: thin public façade delegating to Private.
+// ---------------------------------------------------------------------------
+
+QuickLookOverlay::QuickLookOverlay(QWidget *parent)
+    : QWidget(parent)
+    , d(std::make_unique<Private>(this))
+{
+    setFocusPolicy(Qt::StrongFocus);
+    setAccessibleName(i18n("Quick Look preview"));
+}
+
+QuickLookOverlay::~QuickLookOverlay() = default;
+
+bool QuickLookOverlay::showPreview(const QUrl &fileUrl)
+{
+    return d->showPreview(fileUrl);
+}
+
+void QuickLookOverlay::hidePreview()
+{
+    d->hidePreview();
+}
+
+bool QuickLookOverlay::isPreviewActive() const
+{
+    return d->m_active;
+}
+
+bool QuickLookOverlay::isSupportedMimeType(const QString &mimeType)
+{
+    if (mimeType.startsWith(QLatin1String("image/"))) {
+        return true;
+    }
+
+    if (mimeType == QLatin1String("application/pdf")) {
+#ifdef HAVE_QTPDF
+        return true;
+#else
+        return false;
+#endif
+    }
+
+#ifdef HAVE_QTMULTIMEDIA
+    if (mimeType.startsWith(QLatin1String("video/"))) {
+        return true;
+    }
+    if (mimeType.startsWith(QLatin1String("audio/"))) {
+        return true;
+    }
+#endif
+
+    return false;
+}
+
+qreal QuickLookOverlay::animationProgress() const
+{
+    return d->m_animationProgress;
+}
+
+void QuickLookOverlay::setAnimationProgress(qreal progress)
+{
+    // Clamp defensively so any future property-animation driver that
+    // overshoots (bounce/elastic curves, external Q_PROPERTY writes) cannot
+    // push derived values like the background alpha out of range.
+    d->m_animationProgress = qBound(0.0, progress, 1.0);
+    update();
+}
+
+void QuickLookOverlay::paintEvent(QPaintEvent *event)
+{
+    d->paint(event);
+}
+
+void QuickLookOverlay::mouseDoubleClickEvent(QMouseEvent *event)
+{
+    d->mouseDoubleClickEvent(event);
+}
+
+void QuickLookOverlay::mousePressEvent(QMouseEvent *event)
+{
+    d->mousePressEvent(event);
+}
+
+void QuickLookOverlay::mouseMoveEvent(QMouseEvent *event)
+{
+    d->mouseMoveEvent(event);
+}
+
+void QuickLookOverlay::mouseReleaseEvent(QMouseEvent *event)
+{
+    d->mouseReleaseEvent(event);
+}
+
+void QuickLookOverlay::wheelEvent(QWheelEvent *event)
+{
+    d->wheelEvent(event);
+}
+
+void QuickLookOverlay::keyPressEvent(QKeyEvent *event)
+{
+    d->keyPressEvent(event);
+}
+
+void QuickLookOverlay::resizeEvent(QResizeEvent *event)
+{
+    d->resizeEvent(event);
+}
