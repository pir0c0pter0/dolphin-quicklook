+/*
+ * SPDX-FileCopyrightText: 2026 Mario STJr
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef QUICKLOOKMEDIAHANDLER_H
+#define QUICKLOOKMEDIAHANDLER_H
+
+#include <QImage>
+#include <QObject>
+#include <QSize>
+#include <QUrl>
+#include <QVector>
+
+class QAudioDecoder;
+class QAudioOutput;
+class QMediaPlayer;
+class QTimer;
+class QVideoFrame;
+class QVideoSink;
+
+class QuickLookMediaHandler : public QObject
+{
+    Q_OBJECT
+
+public:
+    explicit QuickLookMediaHandler(QObject *parent = nullptr);
+    ~QuickLookMediaHandler() override;
+
+    enum class ContentType {
+        Video,
+        Audio
+    };
+
+    enum class Phase {
+        Loading,
+        Animating,
+        Playing,
+        Closing
+    };
+
+    void setupVideo(const QUrl &fileUrl);
+    void setupAudio(const QUrl &fileUrl);
+    void cleanup();
+    void pause();
+    void play();
+
+    void onShowAnimationFinished();
+    void setClosing();
+
+    ContentType contentType() const;
+    Phase phase() const;
+    bool isPlaying() const;
+    void setVideoDisplaySize(const QSize &size);
+    void markFrameConsumed();
+
+    qint64 position() const;
+    qint64 duration() const;
+    void seek(qint64 positionMs);
+
+Q_SIGNALS:
+    void contentReady(const QImage &image);
+    void statusTextChanged(const QString &text);
+    void readyToAnimate(const QImage &firstFrame);
+    void loadFailed();
+    void requestUpdate();
+
+private:
+    static constexpr int VideoLoadTimeoutMs = 5000;
+    static constexpr qreal DefaultVolume = 0.5;
+    static constexpr int VideoMaxDisplayWidth = 1920;
+    static constexpr int VideoMaxDisplayHeight = 1080;
+    static constexpr int AudioComposeSize = 800;
+    static constexpr qreal VinylDegreesPerFrame = 33.0 * 360.0 / 60.0 / 30.0;
+    static constexpr int AudioFrameIntervalMs = 33;
+    static constexpr int FftWindowSize = 1024;
+    static constexpr int SpectrumBarCount = 48;
+    static constexpr qreal VinylLabelRatio = 0.33;
+    // ~2 minutes of 44.1 kHz mono samples (~5.3 M floats, ~21 MiB). Past this
+    // the decoder stops reading new buffers; playback continues but the
+    // spectrum analyzer freezes. Keeps memory bounded on long tracks.
+    static constexpr int MaxAudioDecodeSamples = 44100 * 120;
+
+    void cleanupVideo();
+    void cleanupAudio();
+    void composeAudioFrame();
+    void onVideoFrameChanged(const QVideoFrame &frame);
+    void onPlaybackPositionChanged(qint64 position);
+
+    static QImage generateVinylImage(int size);
+    static void computeFFT(std::vector<std::complex<float>> &data);
+    static QVector<float> computeSpectrum(const QVector<float> &samples, int offset, int windowSize, int numBars);
+
+    ContentType m_contentType = ContentType::Video;
+    Phase m_phase = Phase::Loading;
+
+    QMediaPlayer *m_mediaPlayer = nullptr;
+    QVideoSink *m_videoSink = nullptr;
+    QAudioOutput *m_audioOutput = nullptr;
+    QTimer *m_videoLoadTimer = nullptr;
+
+    // Audio-specific
+    QImage m_vinylImage;
+    qreal m_vinylAngle = 0.0;
+    QTimer *m_vinylTimer = nullptr;
+    QAudioDecoder *m_audioDecoder = nullptr;
+    QImage m_audioFrame;
+    QVector<float> m_audioSamples;
+    int m_audioSampleRate = 44100;
+    bool m_audioDecodingDone = false;
+    QVector<float> m_smoothedSpectrum;
+
+    // Video frame throttling
+    bool m_videoFramePending = false;
+    QSize m_videoDisplaySize;
+};
+
+#endif // QUICKLOOKMEDIAHANDLER_H
