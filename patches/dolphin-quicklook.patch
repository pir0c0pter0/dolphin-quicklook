+/*
+ * SPDX-FileCopyrightText: 2026 Pir0c0pter0
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "quicklookcontroller.h"
+
+#include "dolphin_generalsettings.h"
+#include "kitemviews/kitemlistcontainer.h"
+#include "kitemviews/kitemlistcontroller.h"
+#include "kitemviews/kitemlistselectionmanager.h"
+#include "kitemviews/kitemlistview.h"
+#include "quicklookcontenthandler.h"
+#include "quicklookoverlay.h"
+#include "views/dolphinview.h"
+
+#include <QEvent>
+#include <QGraphicsView>
+#include <QKeyEvent>
+#include <QMouseEvent>
+#include <QResizeEvent>
+
+#include <utility>
+
+QuickLookController::QuickLookController(QObject *parent)
+    : QObject(parent)
+{
+    m_overlay = new QuickLookOverlay(nullptr);
+    m_overlay->hide();
+    connect(m_overlay.data(), &QuickLookOverlay::previewClosed, this, &QuickLookController::onPreviewClosed);
+}
+
+QuickLookController::~QuickLookController()
+{
+    detach();
+    if (m_overlay) {
+        // setParent(nullptr) first so Qt's parent-child cleanup does not
+        // race with the explicit delete below.
+        m_overlay->setParent(nullptr);
+        delete m_overlay;
+    }
+}
+
+void QuickLookController::attachToView(DolphinView *view)
+{
+    if (m_view == view) {
+        return;
+    }
+
+    detach();
+
+    if (!view) {
+        return;
+    }
+
+    KItemListContainer *container = view->itemListContainer();
+    if (!container) {
+        return;
+    }
+
+    m_view = view;
+    m_container = container;
+    m_window = container->window();
+
+    if (m_overlay) {
+        m_overlay->setParent(container);
+        m_overlay->hide();
+        m_overlay->resize(container->size());
+    }
+    container->installEventFilter(this);
+    if (auto *graphicsView = qobject_cast<QGraphicsView *>(container->viewport())) {
+        m_mouseTarget = graphicsView->viewport();
+        m_mouseTarget->installEventFilter(this);
+    }
+    if (m_window) {
+        // Dolphin binds unmodified Space to Selection Mode. Accepting the
+        // ShortcutOverride here lets the subsequent KeyPress reach the view
+        // only when Quick Look can actually handle the current selection.
+        m_window->installEventFilter(this);
+    }
+
+    m_viewConnections.append(connect(view, &DolphinView::urlChanged, this, &QuickLookController::closePreview));
+}
+
+void QuickLookController::detach()
+{
+    for (const QMetaObject::Connection &c : std::as_const(m_viewConnections)) {
+        disconnect(c);
+    }
+    m_viewConnections.clear();
+
+    if (m_container) {
+        m_container->removeEventFilter(this);
+    }
+    if (m_mouseTarget) {
+        m_mouseTarget->removeEventFilter(this);
+    }
+    if (m_window) {
+        m_window->removeEventFilter(this);
+    }
+
+    closePreview();
+    if (m_overlay) {
+        // Hide before unparenting so the widget does not briefly appear
+        // as a top-level window if an animation is in flight. The next
+        // showPreview() resets any stale animation state.
+        m_overlay->hide();
+        m_overlay->setParent(nullptr);
+    }
+
+    m_container.clear();
+    m_mouseTarget.clear();
+    m_window.clear();
+    m_view.clear();
+}
+
+void QuickLookController::closePreview()
+{
+    if (!m_overlay || !m_overlay->isPreviewActive() || m_closing) {
+        return;
+    }
+
+    m_closing = true;
+    m_overlay->hidePreview();
+}
+
+bool QuickLookController::eventFilter(QObject *watched, QEvent *event)
+{
+    if (!m_container || !m_overlay) {
+        return QObject::eventFilter(watched, event);
+    }
+
+    const bool useSpace = GeneralSettings::quickLookActivation() == GeneralSettings::EnumQuickLookActivation::Space;
+    if (useSpace && watched == m_window && event->type() == QEvent::ShortcutOverride) {
+        auto *keyEvent = static_cast<QKeyEvent *>(event);
+        if (keyEvent->key() == Qt::Key_Space && keyEvent->modifiers() == Qt::NoModifier && !keyEvent->isAutoRepeat()
+            && (m_overlay->isPreviewActive() || canPreviewSelection())) {
+            keyEvent->accept();
+            return true;
+        }
+        return QObject::eventFilter(watched, event);
+    }
+
+    if (watched == m_mouseTarget && !useSpace && event->type() == QEvent::MouseButtonDblClick) {
+        const auto *mouseEvent = static_cast<QMouseEvent *>(event);
+        auto *graphicsView = qobject_cast<QGraphicsView *>(m_container->viewport());
+        KItemListController *controller = m_container->controller();
+        const auto clickedIndex = controller->view()->itemAt(graphicsView->mapToScene(mouseEvent->position().toPoint()));
+        if (mouseEvent->button() == Qt::LeftButton && clickedIndex
+            && controller->selectionManager()->selectedItems().contains(*clickedIndex) && showSelection()) {
+            return true;
+        }
+        return QObject::eventFilter(watched, event);
+    }
+
+    if (watched != m_container) {
+        return QObject::eventFilter(watched, event);
+    }
+
+    switch (event->type()) {
+    case QEvent::KeyPress: {
+        const auto *keyEvent = static_cast<QKeyEvent *>(event);
+        if (useSpace && keyEvent->key() == Qt::Key_Space && keyEvent->modifiers() == Qt::NoModifier && !keyEvent->isAutoRepeat()
+            && showSelection()) {
+            return true;
+        }
+        break;
+    }
+    case QEvent::Resize:
+        if (m_overlay->isPreviewActive()) {
+            m_overlay->resize(m_container->size());
+        }
+        break;
+    default:
+        break;
+    }
+
+    return QObject::eventFilter(watched, event);
+}
+
+bool QuickLookController::showSelection()
+{
+    if (m_overlay->isPreviewActive() || !canPreviewSelection()) {
+        return false;
+    }
+    m_overlay->resize(m_container->size());
+    if (!m_overlay->showPreview(m_view->selectedItems().constFirst().url())) {
+        return false;
+    }
+    m_closing = false;
+    return true;
+}
+
+bool QuickLookController::canPreviewSelection() const
+{
+    if (!m_view) {
+        return false;
+    }
+    const KFileItemList selectedItems = m_view->selectedItems();
+    if (selectedItems.count() != 1) {
+        return false;
+    }
+    const KFileItem &item = selectedItems.constFirst();
+    return QuickLookOverlay::isSupportedMimeType(item.mimetype()) && QuickLookContentHandler::isReadableLocalFile(item.url());
+}
+
+void QuickLookController::onPreviewClosed()
+{
+    m_closing = false;
+    if (m_container) {
+        m_container->setFocus();
+    }
+}
