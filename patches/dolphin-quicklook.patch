+
+#ifndef QUICKLOOKPDFHANDLER_H
+#define QUICKLOOKPDFHANDLER_H
+
+#include <QHash>
+#include <QImage>
+#include <QList>
+#include <QObject>
+#include <QPdfDocument>
+#include <QPdfDocumentRenderOptions>
+#include <QPdfPageRenderer>
+#include <QSizeF>
+
+class QTimer;
+
+class QuickLookPdfHandler : public QObject
+{
+    Q_OBJECT
+
+public:
+    enum class LoadResult {
+        Success,
+        Failed,
+        PasswordRequired
+    };
+
+    explicit QuickLookPdfHandler(QObject *parent = nullptr);
+    ~QuickLookPdfHandler() override;
+
+    void loadAsync(const QString &filePath);
+    bool unlockWithPassword(const QString &password);
+    void cleanup();
+    void cancelPendingRenders();
+
+    void navigatePage(int direction);
+    void setDisplayArea(int width, int height, qreal devicePixelRatio);
+    void scheduleHiResRerender(qreal zoomFactor);
+
+    int currentPage() const;
+    int totalPages() const;
+    bool isPageLoading() const;
+    bool isHiResRendering() const;
+    qreal spinnerAngle() const;
+    QString statusText() const;
+    QSizeF pageLogicalSize() const;
+
+Q_SIGNALS:
+    void contentReady(const QImage &image);
+    void crossfadeReady(const QImage &newImage, const QImage &oldImage);
+    void statusTextChanged(const QString &text);
+    void pageLoadingChanged(bool loading);
+    void requestUpdate();
+    void asyncLoadReady(LoadResult result);
+    void hiResRenderStarted();
+
+private:
+    static constexpr int CacheMaxPages = 5;
+    static constexpr int RerenderDelayMs = 200;
+    static constexpr int PageRenderDelayMs = 50;
+    // Refuse to open PDFs larger than this on the GUI thread to avoid
+    // freezing Dolphin on decompression-bomb / pathological files.
+    // QPdfDocument::load is synchronous for local files.
+    static constexpr qint64 MaxPdfFileSizeBytes = 256LL * 1024 * 1024; // 256 MiB
+
+    void requestPage(int pageIndex, QSize size);
+    void requestHiRes(int pageIndex, QSize fullSize, QRect clipRect = {});
+    void onPageRendered(int page, QSize imageSize, const QImage &image, QPdfDocumentRenderOptions options, quint64 requestId);
+    QSize previewSize() const;
+    QSize displaySize() const;
+    QSize zoomSize(qreal zoomFactor) const;
+
+    void onHiResTimerTimeout();
+    void prefetchAdjacentPages();
+    void updateStatusText();
+    void startSpinner();
+    void stopSpinner();
+
+    struct CachedPage {
+        QImage image;
+    };
+    void cacheInsert(int pageIndex, const QImage &image);
+    CachedPage cacheLookup(int pageIndex);
+
+    QPdfDocument *m_pdfDoc = nullptr;
+    QPdfPageRenderer *m_pdfRenderer = nullptr;
+    quint64 m_previewRequestId = 0;
+    quint64 m_hiResRequestId = 0;
+    // Bumped by loadAsync() / unlockWithPassword() / cleanup() /
+    // cancelPendingRenders(). Every outstanding render request is tagged
+    // with the generation it was issued in; onPageRendered drops any
+    // callback whose tagged generation does not match m_generation, so
+    // stale renders from a previous document (or a preview the user
+    // already navigated away from) never land in the cache or the overlay.
+    quint64 m_generation = 0;
+    QHash<quint64, quint64> m_pendingRequests;
+
+    QString m_filePath;
+    QImage m_currentImage;
+    int m_currentPage = 0;
+    int m_totalPages = 0;
+
+    int m_areaWidth = 0;
+    int m_areaHeight = 0;
+    qreal m_devicePixelRatio = 1.0;
+
+    QHash<int, CachedPage> m_pageCache;
+    QList<int> m_cacheLru;
+
+    QTimer *m_hiResRenderTimer = nullptr;
+    bool m_renderPending = false;
+    qreal m_lastZoomFactor = 1.0;
+
+    bool m_pageLoading = false;
+    qreal m_spinnerAngle = 0.0;
+    QTimer *m_spinnerTimer = nullptr;
+};
+
+#endif // QUICKLOOKPDFHANDLER_H
