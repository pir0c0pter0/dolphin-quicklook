+
+bool QuickLookOverlay::probeGpuAvailability()
+{
+#ifdef HAVE_OPENGL
+    QOffscreenSurface surface;
+    surface.create();
+    if (!surface.isValid()) {
+        return false;
+    }
+
+    QOpenGLContext context;
+    if (!context.create()) {
+        return false;
+    }
+
+    if (!context.makeCurrent(&surface)) {
+        return false;
+    }
+
+    const auto version = context.format().version();
+    const bool isES = context.isOpenGLES();
+    const bool sufficient = isES ? (version.first >= 2) : (version.first >= 3 || (version.first == 2 && version.second >= 1));
+
+    auto *gl = context.functions();
+    if (!gl) {
+        context.doneCurrent();
+        return false;
+    }
+    const char *rendererStr = reinterpret_cast<const char *>(gl->glGetString(GL_RENDERER));
+    const QString renderer = rendererStr ? QString::fromLatin1(rendererStr) : QString();
+
+    const bool softwareRenderer = renderer.contains(QLatin1String("llvmpipe"), Qt::CaseInsensitive)
+        || renderer.contains(QLatin1String("softpipe"), Qt::CaseInsensitive) || renderer.contains(QLatin1String("swrast"), Qt::CaseInsensitive);
+
+    context.doneCurrent();
+    return sufficient && !softwareRenderer;
+#else
+    return false;
+#endif
+}
+
+QuickLookOverlay::QuickLookOverlay(QWidget *parent)
+    : QWidget(parent)
+    , m_animationProgress(0.0)
+    , m_active(false)
+    , m_contentType(ContentType::Image)
+{
+    setFocusPolicy(Qt::StrongFocus);
+
+    // Probe GPU once (cached across instances)
+    static const bool gpuAvailable = probeGpuAvailability();
+
+#ifdef HAVE_OPENGL
+    if (gpuAvailable) {
+        m_renderer = std::make_unique<QuickLookGLRenderer>(this);
+    } else {
+        m_renderer = std::make_unique<QuickLookSWRenderer>(this);
+    }
+#else
+    Q_UNUSED(gpuAvailable)
+    m_renderer = std::make_unique<QuickLookSWRenderer>(this);
+#endif
+
+    m_renderer->initialize();
+
+    m_hiResRenderTimer = new QTimer(this);
+    m_hiResRenderTimer->setSingleShot(true);
+    connect(m_hiResRenderTimer, &QTimer::timeout, this, &QuickLookOverlay::rerenderHiRes);
+    connect(&m_imageRenderWatcher, &QFutureWatcher<QImage>::finished, this, &QuickLookOverlay::onHiResRenderFinished);
+
+    m_frameTimer = new QTimer(this);
+    m_frameTimer->setInterval(16);
+    connect(m_frameTimer, &QTimer::timeout, this, &QuickLookOverlay::advanceFrame);
+
+#ifdef HAVE_POPPLER
+    m_pdfHandler = new QuickLookPdfHandler(this);
+    connect(m_pdfHandler, &QuickLookPdfHandler::contentReady, this, [this](const QImage &image) {
+        setContentImage(image);
+        uploadContentToRenderer();
+    });
+    connect(m_pdfHandler, &QuickLookPdfHandler::crossfadeReady, this, [this](const QImage &newImage, const QImage &oldImage) {
+        startCrossfade(newImage, oldImage);
+    });
+    connect(m_pdfHandler, &QuickLookPdfHandler::requestUpdate, this, QOverload<>::of(&QWidget::update));
+#endif
+
+#ifdef HAVE_QTMULTIMEDIA
+    m_mediaHandler = new QuickLookMediaHandler(this);
+    connect(m_mediaHandler, &QuickLookMediaHandler::contentReady, this, [this](const QImage &image) {
+        setContentImage(image);
+        uploadContentToRenderer();
+        update();
+    });
+    connect(m_mediaHandler, &QuickLookMediaHandler::readyToAnimate, this, [this](const QImage &firstFrame) {
+        setContentImage(firstFrame);
+        uploadContentToRenderer();
+
+        if (!parentWidget()) {
+            return;
+        }
+        move(0, 0);
+        resize(parentWidget()->size());
+
+        if (m_renderer) {
+            m_renderer->resize(width(), height());
+        }
+
+        show();
+        raise();
+        setFocus();
+        uploadContentToRenderer();
+        startShowAnimation();
+    });
+    connect(m_mediaHandler, &QuickLookMediaHandler::loadFailed, this, [this]() {
+        m_active = false;
+        hide();
+        Q_EMIT previewClosed();
+    });
+    connect(m_mediaHandler, &QuickLookMediaHandler::statusTextChanged, this, [this](const QString &text) {
+        m_statusText = text;
+    });
+#endif
+
+    hide();
+}
+
+QuickLookOverlay::~QuickLookOverlay()
+{
+    m_frameTimer->stop();
+    m_imageRenderWatcher.cancel();
+    m_imageRenderWatcher.waitForFinished();
+    m_imageRenderPending = false;
+    m_hiResRenderTimer->stop();
+
+    if (m_renderer) {
+        m_renderer->cleanup();
+    }
+}
