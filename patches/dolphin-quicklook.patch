+/*
+ * SPDX-FileCopyrightText: 2026 Pir0c0pter0
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef QUICKLOOKCONTROLLER_H
+#define QUICKLOOKCONTROLLER_H
+
+#include "dolphin_export.h"
+
+#include <QList>
+#include <QMetaObject>
+#include <QObject>
+#include <QPointer>
+
+class DolphinView;
+class KItemListContainer;
+class QuickLookOverlay;
+class QWidget;
+
+/**
+ * Owns the QuickLook overlay widget and handles its configured activation and resize events.
+ * The controller follows a single DolphinView at a
+ * time via attachToView() — DolphinTabPage retargets it whenever the
+ * active pane changes in split view.
+ */
+class DOLPHIN_EXPORT QuickLookController : public QObject
+{
+    Q_OBJECT
+
+public:
+    explicit QuickLookController(QObject *parent = nullptr);
+    ~QuickLookController() override;
+
+    /**
+     * Attach to a DolphinView. Any previously attached view is detached
+     * first and any currently visible preview is closed. The overlay is
+     * reparented to @p view's item-list container.
+     */
+    void attachToView(DolphinView *view);
+
+    /** Detach from the current view without destroying the controller. */
+    void detach();
+
+    /** Close the current preview. Safe to call repeatedly. */
+    void closePreview();
+
+protected:
+    bool eventFilter(QObject *watched, QEvent *event) override;
+
+private Q_SLOTS:
+    void onPreviewClosed();
+
+private:
+    bool canPreviewSelection() const;
+    bool showSelection();
+
+    QPointer<DolphinView> m_view;
+    QPointer<KItemListContainer> m_container;
+    QPointer<QWidget> m_mouseTarget;
+    QPointer<QWidget> m_window;
+    // Overlay is owned by the controller. QPointer guards against the
+    // container being destroyed before the controller (in which case Qt
+    // would auto-delete the overlay as a child widget).
+    QPointer<QuickLookOverlay> m_overlay;
+    bool m_closing = false;
+    QList<QMetaObject::Connection> m_viewConnections;
+};
+
+#endif // QUICKLOOKCONTROLLER_H
diff --git a/src/views/quicklook/quicklookimagehandler.cpp b/src/views/quicklook/quicklookimagehandler.cpp
new file mode 100644
index 0000000..b546e5d
--- /dev/null
+++ b/src/views/quicklook/quicklookimagehandler.cpp
@@ -0,0 +1,290 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Pir0c0pter0
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "quicklookimagehandler.h"
+
+#include <QFile>
+#include <QFileInfo>
+#include <QImageReader>
+#include <QTimer>
+#include <QtConcurrent>
+
+#include <cmath>
+
+namespace
+{
+QSize boundedSize(const QSize &source, const QSize &requested, qint64 maxPixels)
+{
+    if (!source.isValid() || !requested.isValid() || requested.isEmpty()) {
+        return {};
+    }
+
+    QSize size = source.scaled(requested, Qt::KeepAspectRatio);
+    const qint64 pixels = static_cast<qint64>(size.width()) * size.height();
+    if (pixels > maxPixels) {
+        const qreal scale = std::sqrt(static_cast<qreal>(maxPixels) / pixels);
+        size = QSize(qMax(1, qFloor(size.width() * scale)), qMax(1, qFloor(size.height() * scale)));
+    }
+    return size;
+}
+}
+
+QuickLookImageHandler::QuickLookImageHandler(QObject *parent)
+    : QuickLookContentHandler(parent)
+{
+    m_rerenderTimer = new QTimer(this);
+    m_rerenderTimer->setSingleShot(true);
+    connect(m_rerenderTimer, &QTimer::timeout, this, &QuickLookImageHandler::rerenderNow);
+    connect(&m_renderWatcher, &QFutureWatcher<DecodeResult>::finished, this, &QuickLookImageHandler::onRenderFinished);
+}
+
+QuickLookImageHandler::~QuickLookImageHandler()
+{
+    close();
+}
+
+QuickLookContentHandler::Kind QuickLookImageHandler::kind() const
+{
+    return Kind::Image;
+}
+
+bool QuickLookImageHandler::open(const QUrl &url)
+{
+    if (!isReadableLocalFile(url)) {
+        return false;
+    }
+    const QString filePath = url.toLocalFile();
+
+    ++m_generation;
+    m_latestSequence = 0;
+    m_renderPending = false;
+    m_pendingTargetWidth = 0;
+    m_hasQueuedDecode = false;
+    if (m_rerenderTimer) {
+        m_rerenderTimer->stop();
+    }
+
+    m_filePath = filePath;
+    m_currentImage = {};
+    m_originalSize = {};
+    m_renderedWidth = 0;
+
+    DecodeRequest request;
+    request.filePath = filePath;
+    request.displayArea = m_displayArea;
+    request.generation = m_generation;
+    request.sequence = ++m_latestSequence;
+    queueDecode(request);
+
+    return true;
+}
+
+void QuickLookImageHandler::close()
+{
+    ++m_generation;
+    m_renderPending = false;
+    m_pendingTargetWidth = 0;
+    m_hasQueuedDecode = false;
+    if (m_rerenderTimer) {
+        m_rerenderTimer->stop();
+    }
+
+    m_filePath.clear();
+    m_currentImage = QImage();
+    m_originalSize = QSize();
+    m_renderedWidth = 0;
+}
+
+bool QuickLookImageHandler::isReady() const
+{
+    return !m_currentImage.isNull();
+}
+
+QString QuickLookImageHandler::statusText() const
+{
+    return {};
+}
+
+QSizeF QuickLookImageHandler::logicalContentSize() const
+{
+    if (m_originalSize.isValid()) {
+        return QSizeF(m_originalSize);
+    }
+    if (!m_currentImage.isNull()) {
+        return QSizeF(m_currentImage.size());
+    }
+    return {};
+}
+
+void QuickLookImageHandler::setViewportSize(const QSize &sizePx)
+{
+    m_displayArea = sizePx;
+}
+
+QImage QuickLookImageHandler::currentImage() const
+{
+    return m_currentImage;
+}
+
+int QuickLookImageHandler::renderedWidth() const
+{
+    return m_renderedWidth;
+}
+
+QSize QuickLookImageHandler::originalPixelSize() const
+{
+    return m_originalSize;
+}
+
+bool QuickLookImageHandler::isHiResRendering() const
+{
+    return m_renderPending;
+}
+
+void QuickLookImageHandler::scheduleHiResRerender(int targetPixelWidth)
+{
+    if (m_filePath.isEmpty() || !m_originalSize.isValid() || m_currentImage.isNull()) {
+        return;
+    }
+    if (targetPixelWidth <= 0 || m_renderedWidth <= 0) {
+        return;
+    }
+
+    const qreal ratio = static_cast<qreal>(m_renderedWidth) / targetPixelWidth;
+    if (ratio > 0.85 && ratio < 1.15) {
+        return;
+    }
+
+    // Cache the target the caller just computed from its own geometry and
+    // zoom state; the timer is debounced so only the most recent target
+    // survives to rerenderNow().
+    m_pendingTargetWidth = targetPixelWidth;
+    m_rerenderTimer->start(HiResRerenderDelayMs);
+}
+
+void QuickLookImageHandler::rerenderNow()
+{
+    if (m_filePath.isEmpty() || !m_originalSize.isValid() || m_pendingTargetWidth <= 0) {
+        return;
+    }
+
+    const int target = m_pendingTargetWidth;
+
+    // Re-check the ratio at fire time: the caller may have scheduled a
+    // rerender and then settled back close to the current rendered width
+    // (e.g. a zoom-out nudged by a subsequent reset). Skip the worker when
+    // the rendered copy is already within tolerance.
+    const qreal ratio = static_cast<qreal>(m_renderedWidth) / target;
+    if (ratio > 0.85 && ratio < 1.15) {
+        return;
+    }
+
+    const QSize origSize = m_originalSize;
+    if (origSize.width() <= 0 || origSize.height() <= 0) {
+        return;
+    }
+
+    DecodeRequest request;
+    request.filePath = m_filePath;
+    request.originalSize = origSize;
+    request.targetWidth = target;
+    request.generation = m_generation;
+    request.sequence = ++m_latestSequence;
+    request.kind = DecodeKind::HiRes;
+    queueDecode(request);
+}
+
+void QuickLookImageHandler::onRenderFinished()
+{
+    m_decodeRunning = false;
+    const DecodeResult result = m_renderWatcher.result();
+    const bool current = result.generation == m_generation && result.sequence == m_latestSequence && result.filePath == m_filePath
+        && !m_filePath.isEmpty();
+
+    if (current && result.kind == DecodeKind::Initial) {
+        if (result.image.isNull()) {
+            Q_EMIT loadFailed();
+        } else {
+            m_currentImage = result.image;
+            m_originalSize = result.originalSize.isValid() ? result.originalSize : result.image.size();
+            m_renderedWidth = result.image.width();
+            Q_EMIT contentReady(result.image);
+        }
+    } else if (current && result.kind == DecodeKind::HiRes && !result.image.isNull()) {
+        const QImage oldImage = m_currentImage;
+        m_currentImage = result.image;
+        m_renderedWidth = result.image.width();
+        Q_EMIT crossfadeReady(result.image, oldImage);
+    }
+
+    if (m_hasQueuedDecode) {
+        const DecodeRequest queued = m_queuedDecode;
+        m_hasQueuedDecode = false;
+        if (queued.generation == m_generation) {
+            startDecode(queued);
+            return;
+        }
+    }
+    m_renderPending = false;
+}
+
+void QuickLookImageHandler::queueDecode(const DecodeRequest &request)
+{
+    if (m_decodeRunning) {
+        m_queuedDecode = request;
+        m_hasQueuedDecode = true;
+        return;
+    }
+    startDecode(request);
+}
+
+void QuickLookImageHandler::startDecode(const DecodeRequest &request)
+{
+    m_decodeRunning = true;
+    if (request.kind == DecodeKind::HiRes) {
+        m_renderPending = true;
+        Q_EMIT hiResRenderStarted();
+    }
+
+    m_renderWatcher.setFuture(QtConcurrent::run([request]() -> DecodeResult {
+        DecodeResult result;
+        result.filePath = request.filePath;
+        result.generation = request.generation;
+        result.sequence = request.sequence;
+        result.kind = request.kind;
+
+        const QFileInfo info(request.filePath);
+        QFile file(request.filePath);
+        if (!info.exists() || !info.isFile() || !info.isReadable() || !file.open(QIODevice::ReadOnly)) {
+            return result;
+        }
+
+        QImageReader reader(&file);
+        reader.setAutoTransform(true);
+        result.originalSize = reader.size();
+
+        QSize requestedSize;
+        if (request.kind == DecodeKind::Initial) {
+            requestedSize = request.displayArea;
+        } else if (request.originalSize.isValid() && request.targetWidth > 0) {
+            const qreal height = static_cast<qreal>(request.originalSize.height()) * request.targetWidth / request.originalSize.width();
+            requestedSize = QSize(request.targetWidth, qMax(1, qFloor(height)));
+        }
+        const QSize scaledSize = boundedSize(result.originalSize, requestedSize, MaxDecodedPixels);
+        if (scaledSize.isValid() && scaledSize != result.originalSize) {
+            reader.setScaledSize(scaledSize);
+        } else if (result.originalSize.isValid()
+                   && static_cast<qint64>(result.originalSize.width()) * result.originalSize.height() > MaxDecodedPixels) {
+            return result;
+        }
+
+        result.image = reader.read();
+        if (!result.image.isNull() && static_cast<qint64>(result.image.width()) * result.image.height() > MaxDecodedPixels) {
+            result.image = {};
+        }
+        return result;
+    }));
+}
diff --git a/src/views/quicklook/quicklookimagehandler.h b/src/views/quicklook/quicklookimagehandler.h
new file mode 100644
index 0000000..2e0224e
--- /dev/null
+++ b/src/views/quicklook/quicklookimagehandler.h
@@ -0,0 +1,103 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Pir0c0pter0
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef QUICKLOOKIMAGEHANDLER_H
+#define QUICKLOOKIMAGEHANDLER_H
+
+#include "quicklookcontenthandler.h"
+
+#include <QFutureWatcher>
+#include <QImage>
+#include <QSize>
+#include <QString>
+
+class QTimer;
+
+class QuickLookImageHandler : public QuickLookContentHandler
+{
+    Q_OBJECT
+
+public:
+    explicit QuickLookImageHandler(QObject *parent = nullptr);
+    ~QuickLookImageHandler() override;
+
+    // QuickLookContentHandler interface
+    Kind kind() const override;
+    bool open(const QUrl &url) override;
+    void close() override;
+    bool isReady() const override;
+    QString statusText() const override;
+    QSizeF logicalContentSize() const override;
+    // The overlay calls this before open() so the initial decode can be
+    // capped to the display area. The value is stored in device pixels.
+    void setViewportSize(const QSize &sizePx) override;
+
+    // Image-specific API. Both initial decode and hi-res rerenders are
+    // asynchronous; currentImage() stays null until contentReady().
+    QImage currentImage() const;
+    int renderedWidth() const;
+    QSize originalPixelSize() const;
+    bool isHiResRendering() const;
+
+    void scheduleHiResRerender(int targetPixelWidth);
+
+Q_SIGNALS:
+    // Fired when a hi-res rerender actually begins dispatching a worker —
+    // the overlay uses this to start its frame timer so the render spinner
+    // can animate. Common signals (crossfadeReady, loadFailed, requestUpdate,
+    // statusTextChanged) are inherited from QuickLookContentHandler.
+    void hiResRenderStarted();
+
+private:
+    static constexpr int HiResRerenderDelayMs = 200;
+    static constexpr qint64 MaxDecodedPixels = 32LL * 1024 * 1024;
+
+    enum class DecodeKind {
+        Initial,
+        HiRes,
+    };
+    struct DecodeRequest {
+        QString filePath;
+        QSize displayArea;
+        QSize originalSize;
+        int targetWidth = 0;
+        quint64 generation = 0;
+        quint64 sequence = 0;
+        DecodeKind kind = DecodeKind::Initial;
+    };
+    struct DecodeResult {
+        QImage image;
+        QSize originalSize;
+        QString filePath;
+        quint64 generation = 0;
+        quint64 sequence = 0;
+        DecodeKind kind = DecodeKind::Initial;
+    };
+
+    void rerenderNow();
+    void onRenderFinished();
+    void queueDecode(const DecodeRequest &request);
+    void startDecode(const DecodeRequest &request);
+
+    QString m_filePath;
+    QImage m_currentImage;
+    QSize m_originalSize;
+    int m_renderedWidth = 0;
+
+    QFutureWatcher<DecodeResult> m_renderWatcher;
+    DecodeRequest m_queuedDecode;
+    bool m_hasQueuedDecode = false;
+    bool m_decodeRunning = false;
+    quint64 m_generation = 0;
+    quint64 m_latestSequence = 0;
+    int m_pendingTargetWidth = 0;
+    bool m_renderPending = false;
+
+    QTimer *m_rerenderTimer = nullptr;
+    QSize m_displayArea;
+};
+
+#endif // QUICKLOOKIMAGEHANDLER_H
